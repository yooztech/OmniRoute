+test("real quota refresh writes the new window before probing the same account", async () => {
+  const { createProviderConnection } = await import("../../src/lib/db/providers.ts");
+  const { getProviderLimitsCache, setProviderLimitsCache, claimProviderLimitsReset } =
+    await import("../../src/lib/db/providerLimits.ts");
+  const { fetchAndPersistProviderLimits } = await import("../../src/lib/usage/providerLimits.ts");
+  const { sendConnectionTestMessage } = await import("../../src/lib/api/connectionTestMessage.ts");
+  const { updateSettings } = await import("../../src/lib/db/settings.ts");
+  const { resetDbInstance } = await import("../../src/lib/db/core.ts");
+  const selected = await createProviderConnection({
+    provider: "glm",
+    authType: "apikey",
+    apiKey: "reset-probe-selected",
+    providerSpecificData: { connectionTestModel: "glm-4.7" },
+  });
+  await createProviderConnection({
+    provider: "glm",
+    authType: "apikey",
+    apiKey: "reset-probe-unselected",
+  });
+  await updateSettings({ connectionTestPrompt: "Reply with only 2.", hidePaidModels: false });
+  const elapsedReset = Date.now() - 1_000;
+  const beforeReset = {
+    ...cache({ session: window(elapsedReset) }),
+    fetchedAt: iso(elapsedReset - 1_000),
+  };
+  setProviderLimitsCache(selected.id, beforeReset);
+  const originalFetch = globalThis.fetch;
+  const events: string[] = [];
+  const nextReset = Date.now() + 3_600_000;
+  globalThis.fetch = async (input, init) => {
+    const url = String(input);
+    if (url.endsWith("/usage/quota/limit")) {
+      events.push("quota");
+      return Response.json({
+        code: 200,
+        success: true,
+        data: {
+          limits: [
+            {
+              type: "TOKENS_LIMIT",
+              unit: 3,
+              number: 5,
+              percentage: 13,
+              nextResetTime: Math.floor(nextReset / 1000),
+              models: [],
+            },
+          ],
+        },
+      });
+    }
+    if (url.endsWith("/chat/completions")) {
+      events.push("chat");
+      assert.match(new Headers(init?.headers).get("authorization") || "", /reset-probe-selected/);
+      assert.ok(Date.parse(getProviderLimitsCache(selected.id)?.fetchedAt || "") > elapsedReset);
+      const body = JSON.parse(String(init?.body));
+      assert.equal(body.model, "glm-4.7");
+      assert.equal(body.messages.at(-1).content, "Reply with only 2.");
+      const chunk = JSON.stringify({
+        id: "quota-reset-probe",
+        object: "chat.completion.chunk",
+        model: "glm-4.7",
+        choices: [{ index: 0, delta: { role: "assistant", content: "2" }, finish_reason: null }],
+      });
+      return new Response(`data: ${chunk}\n\ndata: [DONE]\n\n`, {
+        headers: { "content-type": "text/event-stream" },
+      });
+    }
+    throw new Error(`Unexpected test URL: ${url}`);
+  };
+  try {
+    const deps = {
+      getCaches: () => ({ [selected.id]: beforeReset }),
+      claim: claimProviderLimitsReset,
+      refresh: (id: string) =>
+        fetchAndPersistProviderLimits(id, "scheduled", { forceRefresh: true, activeOnly: true }),
+      sendTest: async (id: string) => {
+        const result = await sendConnectionTestMessage(id);
+        if (result.ok && result.responseText === "2") events.push("ok");
+        return result;
+      },
+      spacingMs: 0,
+    };
+    await runProviderLimitsResetSync(deps, elapsedReset);
+    await runProviderLimitsResetSync(deps, elapsedReset);
+    assert.deepEqual(events, ["quota", "chat", "ok"]);
+  } finally {
+    globalThis.fetch = originalFetch;
+    resetDbInstance();
+  }
+});
