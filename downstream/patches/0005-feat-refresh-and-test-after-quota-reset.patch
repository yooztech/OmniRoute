@@ -0,0 +1,291 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+import type { ProviderLimitsCacheEntry } from "../../src/lib/db/providerLimits.ts";
+import { runProviderLimitsResetSync } from "../../src/shared/services/providerLimitsResetSync.ts";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "provider-reset-sync-"));
+process.env.DATA_DIR = dataDir;
+
+test.after(async () => {
+  const { resetDbInstance } = await import("../../src/lib/db/core.ts");
+  resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+});
+
+const now = Date.parse("2026-06-01T12:00:00.000Z");
+const iso = (time: number) => new Date(time).toISOString();
+const window = (time: number) => ({ resetAt: iso(time), remainingPercentage: 0 });
+const cache = (
+  quotas: Record<string, unknown>,
+  modelQuotas: Record<string, unknown> = {}
+): ProviderLimitsCacheEntry => ({
+  quotas,
+  modelQuotas,
+  fetchedAt: iso(now - 10_000),
+  plan: null,
+  message: null,
+});
+const fresh = { usage: { quotas: { session: { remainingPercentage: 100 } } } };
+
+function fakeClaim() {
+  const claims = new Map<string, number>();
+  return (id: string, reset: number) => {
+    if ((claims.get(id) ?? -Infinity) >= reset) return false;
+    claims.set(id, reset);
+    return true;
+  };
+}
+
+test("only due windows newer than their fetch are claimed, coalesced by account, and refreshed before sending", async () => {
+  const calls: string[] = [];
+  const claimed: Array<[string, number]> = [];
+  const deps = {
+    getCaches: () => ({
+      due: cache(
+        { old: window(now - 3_000), current: window(now), future: window(now + 1) },
+        { model: window(now - 1_000) }
+      ),
+      future: cache({ session: window(now + 1) }),
+      observedAfterReset: {
+        ...cache({ session: window(now - 1_000) }),
+        fetchedAt: iso(now - 1_000),
+      },
+      invalid: cache({ session: { resetAt: "invalid" } }),
+    }),
+    claim: (id: string, reset: number) => {
+      claimed.push([id, reset]);
+      return true;
+    },
+    refresh: async (id: string) => {
+      calls.push(`refresh:${id}`);
+      return fresh;
+    },
+    sendTest: async (id: string) => {
+      calls.push(`send:${id}`);
+      return { ok: true };
+    },
+    spacingMs: 0,
+  };
+  await runProviderLimitsResetSync(deps, now);
+  assert.deepEqual(claimed, [["due", now]]);
+  assert.deepEqual(calls, ["refresh:due", "send:due"]);
+});
+
+test("refresh completes before exactly one test message, including for model-only fresh data", async () => {
+  const gate = Promise.withResolvers<{ usage: Record<string, unknown> }>();
+  const calls: string[] = [];
+  const deps = {
+    getCaches: () => ({ account: cache({}, { first: window(now - 1), second: window(now - 1) }) }),
+    claim: fakeClaim(),
+    refresh: async (id: string) => {
+      calls.push(`refresh:${id}`);
+      return gate.promise;
+    },
+    sendTest: async (id: string) => {
+      calls.push(`send:${id}`);
+      return { ok: true };
+    },
+    spacingMs: 0,
+  };
+  const pending = runProviderLimitsResetSync(deps, now);
+  assert.deepEqual(calls, ["refresh:account"]);
+  gate.resolve({ usage: { modelQuotas: { model: { remainingPercentage: 100 } } } });
+  await pending;
+  assert.deepEqual(calls, ["refresh:account", "send:account"]);
+});
+
+test("stale, error, and empty refresh results never send a test message", async () => {
+  const results: Record<string, { usage: Record<string, unknown> }> = {
+    stale: { usage: { quotas: { session: {} }, _stale: true } },
+    message: { usage: { quotas: { session: {} }, message: "upstream error" } },
+    empty: { usage: { quotas: {}, modelQuotas: {} } },
+    missing: { usage: {} },
+    valid: fresh,
+  };
+  const sent: string[] = [];
+  await runProviderLimitsResetSync(
+    {
+      getCaches: () =>
+        Object.fromEntries(Object.keys(results).map((id) => [id, cache({ session: window(now) })])),
+      claim: fakeClaim(),
+      refresh: async (id) => results[id],
+      sendTest: async (id) => {
+        sent.push(id);
+        return { ok: true };
+      },
+      spacingMs: 0,
+    },
+    now
+  );
+  assert.deepEqual(sent, ["valid"]);
+});
+
+test("refresh and send exceptions do not prevent other accounts being processed", async () => {
+  const events: string[] = [];
+  await runProviderLimitsResetSync(
+    {
+      getCaches: () =>
+        Object.fromEntries(
+          ["refresh-fails", "send-fails", "healthy"].map((id) => [
+            id,
+            cache({ session: window(now) }),
+          ])
+        ),
+      claim: fakeClaim(),
+      refresh: async (id) => {
+        events.push(`refresh:${id}`);
+        if (id === "refresh-fails") throw new Error("refresh failed");
+        return fresh;
+      },
+      sendTest: async (id) => {
+        events.push(`send:${id}`);
+        if (id === "send-fails") throw new Error("send failed");
+        return { ok: true };
+      },
+      spacingMs: 0,
+    },
+    now
+  );
+  assert.deepEqual(events, [
+    "refresh:refresh-fails",
+    "refresh:send-fails",
+    "send:send-fails",
+    "refresh:healthy",
+    "send:healthy",
+  ]);
+});
+
+test("database claims deduplicate concurrent and repeated runs but allow a later reset", async () => {
+  const core = await import("../../src/lib/db/core.ts");
+  const { claimProviderLimitsReset } = await import("../../src/lib/db/providerLimits.ts");
+  try {
+    let reset = now - 1_000;
+    const gate = Promise.withResolvers<typeof fresh>();
+    let refreshes = 0;
+    const sent: string[] = [];
+    const deps = {
+      getCaches: () => ({ account: cache({ session: window(reset), weekly: window(reset) }) }),
+      claim: claimProviderLimitsReset,
+      refresh: async () => {
+        refreshes++;
+        if (refreshes === 1) return gate.promise;
+        return fresh;
+      },
+      sendTest: async (id: string) => {
+        sent.push(id);
+        return { ok: true };
+      },
+      spacingMs: 0,
+    };
+    const first = runProviderLimitsResetSync(deps, now);
+    await runProviderLimitsResetSync(deps, now);
+    assert.equal(refreshes, 1);
+    assert.deepEqual(sent, []);
+    gate.resolve(fresh);
+    await first;
+    core.resetDbInstance();
+    await runProviderLimitsResetSync(deps, now);
+    assert.equal(refreshes, 1);
+    assert.deepEqual(sent, ["account"]);
+    reset = now;
+    await runProviderLimitsResetSync(deps, now);
+    assert.equal(refreshes, 2);
+    assert.deepEqual(sent, ["account", "account"]);
+  } finally {
+    core.resetDbInstance();
+  }
+});
