diff --git a/src/shared/services/providerLimitsResetSync.ts b/src/shared/services/providerLimitsResetSync.ts
new file mode 100644
index 0000000000..858c3e30df
--- /dev/null
+++ b/src/shared/services/providerLimitsResetSync.ts
@@ -0,0 +1,59 @@
+import { setTimeout as delay } from "node:timers/promises";
+import type { ProviderLimitsCacheEntry } from "@/lib/db/providerLimits";
+import { isRecord } from "@/lib/usage/providerLimits/quotaNormalize";
+
+interface ResetSyncDeps {
+  getCaches(): Record<string, ProviderLimitsCacheEntry>;
+  claim(connectionId: string, resetAtMs: number): boolean;
+  refresh(connectionId: string): Promise<{ usage: Record<string, unknown> }>;
+  sendTest(connectionId: string): Promise<{ ok: boolean; httpStatus?: number }>;
+  spacingMs: number;
+}
+
+function latestDueReset(cache: ProviderLimitsCacheEntry, nowMs: number): number | null {
+  const fetchedAt = Date.parse(cache.fetchedAt);
+  if (cache.message || !Number.isFinite(fetchedAt)) return null;
+  let latest = fetchedAt;
+  for (const windows of [cache.quotas, cache.modelQuotas]) {
+    if (!windows) continue;
+    for (const window of Object.values(windows)) {
+      if (!isRecord(window) || typeof window.resetAt !== "string") continue;
+      const resetAt = Date.parse(window.resetAt);
+      if (resetAt <= nowMs && resetAt > latest) latest = resetAt;
+    }
+  }
+  return latest > fetchedAt ? latest : null;
+}
+
+function hasQuotaWindows(value: unknown): boolean {
+  return isRecord(value) && Object.values(value).some(isRecord);
+}
+
+export async function runProviderLimitsResetSync(deps: ResetSyncDeps, nowMs = Date.now()) {
+  let paceBeforeNextRefresh = false;
+  for (const [connectionId, cache] of Object.entries(deps.getCaches())) {
+    const resetAt = latestDueReset(cache, nowMs);
+    if (resetAt === null) continue;
+    try {
+      if (!deps.claim(connectionId, resetAt)) continue;
+      if (paceBeforeNextRefresh && deps.spacingMs > 0) await delay(deps.spacingMs);
+      paceBeforeNextRefresh = true;
+      const { usage } = await deps.refresh(connectionId);
+      if (usage._stale === true || usage.message) continue;
+      if (!hasQuotaWindows(usage.quotas) && !hasQuotaWindows(usage.modelQuotas)) continue;
+
+      const result = await deps.sendTest(connectionId);
+      if (result.ok) {
+        console.log(`[ProviderLimitsSync] Reset test message succeeded: ${connectionId}`);
+      } else if (result.httpStatus !== 400) {
+        // No configured test model is a normal reason not to send.
+        console.warn(
+          `[ProviderLimitsSync] Reset test message not sent or failed: ${connectionId} (${result.httpStatus ?? "unknown"})`
+        );
+      }
+    } catch {
+      // Do not log upstream error bodies or retry a possibly dispatched test request.
+      console.warn(`[ProviderLimitsSync] Reset refresh or test message failed: ${connectionId}`);
+    }
+  }
+}
