diff --git a/src/lib/api/connectionTestMessage.ts b/src/lib/api/connectionTestMessage.ts
new file mode 100644
index 0000000000..f0bb55949a
--- /dev/null
+++ b/src/lib/api/connectionTestMessage.ts
@@ -0,0 +1,90 @@
+import { z } from "zod";
+import { getProviderConnectionById } from "@/lib/db/providers";
+import { getSettings } from "@/lib/db/settings";
+import { runSingleModelTest } from "@/lib/api/modelTestRunner";
+import { sanitizeErrorMessage } from "@omniroute/open-sse/utils/error.ts";
+import { DEFAULT_CONNECTION_TEST_PROMPT } from "@/shared/constants/connectionTest";
+import { isFreeModel, providerHasFreeModels } from "@/shared/utils/freeModels";
+import { getProviderAlias } from "@/shared/constants/providers";
+
+export const connectionTestModelSchema = z
+  .object({
+    modelId: z
+      .string()
+      .trim()
+      .min(1)
+      .max(256)
+      .regex(/^[a-zA-Z0-9@][a-zA-Z0-9._:/@+-]*$/),
+  })
+  .strict();
+
+export function configuredConnectionTestModel(connection: Record<string, unknown>) {
+  const data = connection.providerSpecificData as Record<string, unknown> | undefined;
+  return typeof data?.connectionTestModel === "string" ? data.connectionTestModel : "";
+}
+
+const sending = new Set<string>();
+
+type SendResult =
+  | {
+      ok: true;
+      modelId: string;
+      prompt: string;
+      responseText: string | undefined;
+      latencyMs: number;
+    }
+  | { ok: false; error: string; httpStatus: number };
+
+function failure(message: unknown, httpStatus: number): SendResult {
+  return { ok: false, error: sanitizeErrorMessage(message), httpStatus };
+}
+
+export async function sendConnectionTestMessage(connectionId: string): Promise<SendResult> {
+  if (sending.has(connectionId))
+    return failure("A test message is already running for this account", 409);
+  sending.add(connectionId);
+  try {
+    const connection = await getProviderConnectionById(connectionId);
+    if (!connection) return failure("Connection not found", 404);
+    if (connection.isActive === false)
+      return failure("Activate this account before sending a test message", 409);
+    const modelId = configuredConnectionTestModel(connection);
+    if (!connectionTestModelSchema.safeParse({ modelId }).success)
+      return failure("Choose a test model for this account first", 400);
+    const provider = connection.provider as string;
+    const prefix = [provider, getProviderAlias(provider)].find(
+      (p) => p && modelId.startsWith(`${p}/`)
+    );
+    const upstreamModel = prefix ? modelId.slice(prefix.length + 1) : modelId;
+    const settings = await getSettings();
+    if (
+      settings.hidePaidModels === true &&
+      !(providerHasFreeModels(provider) && isFreeModel(provider, { id: upstreamModel }))
+    ) {
+      return failure("Paid model blocked while hidePaidModels is enabled", 403);
+    }
+    const prompt =
+      (settings.connectionTestPrompt as string | undefined) || DEFAULT_CONNECTION_TEST_PROMPT;
+    const result = await runSingleModelTest({
+      providerId: provider,
+      modelId: `${provider}/${upstreamModel}`,
+      connectionId,
+      prompt,
+      timeoutMs: 60_000,
+      streamChat: true,
+    });
+    if (result.status !== "ok")
+      return failure(result.error || "Test message failed", result.httpStatus);
+    return {
+      ok: true,
+      modelId,
+      prompt,
+      responseText: result.responseText,
+      latencyMs: result.latencyMs,
+    };
+  } catch (error) {
+    return failure(error, 500);
+  } finally {
+    sending.delete(connectionId);
+  }
+}
