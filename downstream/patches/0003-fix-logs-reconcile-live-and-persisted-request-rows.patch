diff --git a/src/lib/usage/usageHistory.ts b/src/lib/usage/usageHistory.ts
index 314671a4..3d94c73c 100644
--- a/src/lib/usage/usageHistory.ts
+++ b/src/lib/usage/usageHistory.ts
@@ -66,6 +66,9 @@ export type PendingRequestDetail = {
   provider: string;
   connectionId: string | null;
   startedAt: number;
+  // In-memory identity survives the completed preview's structured clone.
+  callLogAttemptId?: string;
+  persistedCallLogId?: string;
   clientEndpoint?: string | null;
   clientRequest?: unknown;
   providerRequest?: unknown;
@@ -723,6 +726,21 @@ export function getPendingById(): Map<string, PendingRequestDetail> {
   return pendingById;
 }
 
+/** Capture this attempt before persistence can yield to a later retry. */
+export function captureCallLogAttempt(id: string | undefined): ((rowId: string) => void) | undefined {
+  if (!id) return;
+  const detail = pendingById.get(id) ?? getCompletedDetails().get(id);
+  if (!detail) return;
+  const attemptId = (detail.callLogAttemptId ??= globalThis.crypto.randomUUID());
+  return (rowId: string) => {
+    // Finalization clones the detail; compare its attempt identity, not just the
+    // pending id (which is deliberately reused by retries).
+    for (const current of [pendingById.get(id), getCompletedDetails().get(id)]) {
+      if (current?.callLogAttemptId === attemptId) current.persistedCallLogId = rowId;
+    }
+  };
+}
+
 /**
  * Clear all pending request counts.
  * Used for admin reset when counts leak due to uncaught timeouts or process-level errors.
diff --git a/tests/unit/call-log-persisted-bridge.test.ts b/tests/unit/call-log-persisted-bridge.test.ts
new file mode 100644
index 00000000..2643ef38
--- /dev/null
+++ b/tests/unit/call-log-persisted-bridge.test.ts
@@ -0,0 +1,106 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "call-log-bridge-"));
+process.env.DATA_DIR = dataDir;
+// The database modules must load after the isolated DATA_DIR is set.
+const history = await import("../../src/lib/usage/usageHistory.ts");
+const { saveCallLog, getCallLogs, closeCallLogSaves } = await import("../../src/lib/usage/callLogs.ts");
+const { buildCallLogListRows } = await import("../../src/app/api/usage/call-logs/route.ts");
+const { clearCompletedDetails } = await import("../../src/lib/usage/completedRequestDetails.ts");
+const { getDbInstance, resetDbInstance } = await import("../../src/lib/db/core.ts");
+
+const start = (correlationId: string) => {
+  const id = history.trackPendingRequest("model", "provider", "connection", true, { correlationId });
+  assert.ok(id);
+  return id;
+};
+const finish = (id: string) => history.finalizePendingRequestById(id, { status: 200 });
+const save = (id: string, rowId: string, correlationId: string) =>
+  saveCallLog({ id: rowId, pendingRequestId: id, correlationId, model: "model", provider: "provider", status: 200 });
+const rows = (logs: unknown[]) => buildCallLogListRows({
+  logs, connections: [], pendingDetails: history.getPendingById().values(),
+  completedDetails: history.getCompletedDetails().values(),
+});
+const dbRows = (correlationId: string) => getCallLogs({ correlationId });
+
+test.after(() => {
+  clearCompletedDetails();
+  resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true });
+});
+
+for (const finalizeFirst of [false, true]) {
+  test(`persisted row replaces its bridge (finalize first: ${finalizeFirst})`, async () => {
+    const correlation = `order-${finalizeFirst}`;
+    const id = start(correlation);
+    if (finalizeFirst) finish(id);
+    await save(id, `row-${correlation}`, correlation);
+    const logs = await dbRows(correlation);
+    assert.equal(logs.length, 1);
+    assert.deepEqual(rows(logs).filter((r) => r.correlationId === correlation).map((r) => r.id), [`row-${correlation}`]);
+    if (!finalizeFirst) finish(id);
+    assert.deepEqual(rows(logs).filter((r) => r.correlationId === correlation).map((r) => r.id), [`row-${correlation}`]);
+    assert.ok(rows([]).some((r) => r.id === id), "bridge remains when its persisted row is outside the page/filter");
+  });
+}
+
+test("persisted attempts stay separate and a newer retry remains active", async () => {
+  const correlation = "retry";
+  const id = start(correlation);
+  await save(id, "retry-row-1", correlation);
+  finish(id);
+  const retryId = start(correlation);
+  assert.equal(retryId, id);
+  let logs = await dbRows(correlation);
+  let result = rows(logs).filter((r) => r.correlationId === correlation);
+  assert.equal(result.length, 2);
+  assert.ok(result.some((r) => r.id === id && r.active));
+  await save(retryId, "retry-row-2", correlation);
+  finish(retryId);
+  logs = await dbRows(correlation);
+  result = rows(logs).filter((r) => r.correlationId === correlation);
+  assert.deepEqual(new Set(result.map((r) => r.id)), new Set(["retry-row-1", "retry-row-2"]));
+  assert.equal(result.length, 2);
+});
+
+test("late insertion of an earlier attempt cannot hide a newer active retry", async () => {
+  const correlation = "late";
+  const id = start(correlation);
+  const saving = save(id, "late-row", correlation);
+  finish(id);
+  assert.equal(start(correlation), id);
+  await saving;
+  const result = rows(await dbRows(correlation)).filter((r) => r.correlationId === correlation);
+  assert.equal(result.length, 2);
+  assert.ok(result.some((r) => r.id === id && r.active));
+  finish(id);
+});
+
+test("same-id persisted row does not duplicate an active bridge", async () => {
+  const correlation = "same-id";
+  const id = start(correlation);
+  await save(id, id, correlation);
+  const result = rows(await dbRows(correlation)).filter((r) => r.correlationId === correlation);
+  assert.equal(result.length, 1);
+  assert.equal(result[0].id, id);
+  finish(id);
+});
+
+test("failed and disabled writes leave their bridges visible", async () => {
+  const db = getDbInstance();
+  db.exec("CREATE TRIGGER bridge_reject BEFORE INSERT ON call_logs BEGIN SELECT RAISE(FAIL, 'bridge test failure'); END");
+  const id = start("failed");
+  await save(id, "failed-row", "failed");
+  finish(id);
+  db.exec("DROP TRIGGER bridge_reject");
+  assert.ok(rows([]).some((r) => r.id === id && r.completed));
+  await closeCallLogSaves();
+  const disabledId = start("disabled");
+  await save(disabledId, "disabled-row", "disabled");
+  finish(disabledId);
+  assert.ok(rows([]).some((r) => r.id === disabledId && r.completed));
+});
