diff --git a/src/shared/reasoning/upstreamEffort.ts b/src/shared/reasoning/upstreamEffort.ts
new file mode 100644
index 00000000..5cb96919
--- /dev/null
+++ b/src/shared/reasoning/upstreamEffort.ts
@@ -0,0 +1,24 @@
+import { CANONICAL_EFFORT_VALUES } from "./effortStandardization";
+
+const UPSTREAM_EFFORTS = new Set<string>([...CANONICAL_EFFORT_VALUES, "minimal", "ultra"]);
+
+/** Canonicalizes only effort values that the upstream request parser recognizes. */
+export function normalizeUpstreamReasoningEffort(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const effort = value.trim().toLowerCase();
+  return UPSTREAM_EFFORTS.has(effort) ? effort : null;
+}
+
+/** Reads only an explicit effort serialized in an upstream request body. */
+export function readUpstreamReasoningEffort(body: unknown): string | null {
+  if (!body || typeof body !== "object" || Array.isArray(body)) return null;
+
+  const record = body as Record<string, unknown>;
+  const nestedReasoning = record.reasoning;
+  const nestedEffort =
+    nestedReasoning && typeof nestedReasoning === "object" && !Array.isArray(nestedReasoning)
+      ? (nestedReasoning as Record<string, unknown>).effort
+      : undefined;
+  const raw = record.reasoning_effort ?? nestedEffort;
+  return normalizeUpstreamReasoningEffort(raw);
+}
