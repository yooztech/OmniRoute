diff --git a/tests/unit/log-badges-reasoning.test.ts b/tests/unit/log-badges-reasoning.test.ts
new file mode 100644
index 0000000000..8bfe1fa426
--- /dev/null
+++ b/tests/unit/log-badges-reasoning.test.ts
@@ -0,0 +1,213 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { Capture } from "../../open-sse/utils/providerRequestLogging.ts";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "log-badge-lifecycle-"));
+process.env.DATA_DIR = dataDir;
+
+// These modules read DATA_DIR during initialization, so test isolation requires lazy loading.
+const core = await import("../../src/lib/db/core.ts");
+const { saveCallLog, getCallLogs } = await import("../../src/lib/usage/callLogs.ts");
+const { buildCallLogListRows } = await import("../../src/app/api/usage/call-logs/route.ts");
+const {
+  clearPendingRequests,
+  finalizePendingRequestById,
+  getCompletedDetails,
+  getPendingById,
+  trackPendingRequest,
+} = await import("../../src/lib/usage/usageHistory.ts");
+const { createPreparedRequestLogger } = await import(
+  "../../open-sse/utils/providerRequestLogging.ts"
+);
+
+test.after(() => {
+  clearPendingRequests();
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+});
+
+test.afterEach(() => {
+  clearPendingRequests();
+});
+
+function startCapturedRequest(provider = "codex") {
+  const id = trackPendingRequest("gpt-5", provider, "connection", true, {});
+  assert.ok(id);
+  let requestedServiceTier: string | null = null;
+  let reasoningEffortUpstream: string | null = null;
+  const capture = createPreparedRequestLogger(
+    { logTargetRequest() {} },
+    { id, model: "gpt-5", provider, connectionId: "connection" },
+    (tier) => {
+      requestedServiceTier = tier;
+    },
+    (effort) => {
+      reasoningEffortUpstream = effort;
+    }
+  );
+  return {
+    id,
+    capture,
+    requestedServiceTier: () => requestedServiceTier,
+    reasoningEffortUpstream: () => reasoningEffortUpstream,
+  };
+}
+
+async function captureBody(capture: Capture, body: Record<string, unknown>) {
+  await capture.capture({
+    url: "https://api.openai.test/v1/responses",
+    headers: { "content-type": "application/json" },
+    body,
+    bodyString: JSON.stringify(body),
+  });
+}
+
+test("captured upstream Codex intent updates the owned pending request and later capture replaces or clears it", async () => {
+  const request = startCapturedRequest();
+
+  await captureBody(request.capture, {
+    service_tier: "priority",
+    reasoning: { effort: "high" },
+  });
+  assert.equal(request.requestedServiceTier(), "priority");
+  assert.equal(request.reasoningEffortUpstream(), "high");
+  const firstPending = getPendingById().get(request.id);
+  assert.equal(firstPending?.requestedServiceTier, "priority");
+  assert.equal(firstPending?.reasoningEffortUpstream, "high");
+  await captureBody(request.capture, {
+    service_tier: "flex",
+    reasoning_effort: "xhigh",
+  });
+  assert.equal(request.requestedServiceTier(), "flex");
+  const replacedPending = getPendingById().get(request.id);
+  assert.equal(replacedPending?.requestedServiceTier, "flex");
+  assert.equal(replacedPending?.reasoningEffortUpstream, "xhigh");
+  await captureBody(request.capture, { service_tier: "default" });
+  assert.equal(request.requestedServiceTier(), "default");
+  assert.equal(request.reasoningEffortUpstream(), null);
+  const clearedPending = getPendingById().get(request.id);
+  assert.equal(clearedPending?.requestedServiceTier, "default");
+  assert.equal(clearedPending?.reasoningEffortUpstream, null);
+  await captureBody(request.capture, {});
+  assert.equal(getPendingById().get(request.id)?.requestedServiceTier, null);
+  assert.equal(getPendingById().get(request.id)?.reasoningEffortUpstream, null);
+
+  const nonCodex = startCapturedRequest("openai");
+  await captureBody(nonCodex.capture, {
+    service_tier: "priority",
+    reasoning: { effort: "high" },
+  });
+  assert.equal(nonCodex.requestedServiceTier(), null);
+  assert.equal(nonCodex.reasoningEffortUpstream(), "high");
+});
+
+test("explicit null upstream effort clears nested effort, while undefined falls back", async () => {
+  const request = startCapturedRequest();
+  await captureBody(request.capture, { reasoning_effort: null, reasoning: { effort: "high" } });
+  assert.equal(request.reasoningEffortUpstream(), null);
+  assert.equal(getPendingById().get(request.id)?.reasoningEffortUpstream, null);
+  await captureBody(request.capture, { reasoning_effort: undefined, reasoning: { effort: "high" } });
+  assert.equal(request.reasoningEffortUpstream(), "high");
+});
+
+test("captured request intent survives SQLite and in-memory API list-row lifecycles", async () => {
+  const captured = startCapturedRequest();
+  await captureBody(captured.capture, {
+    service_tier: "priority",
+    reasoning: { effort: "high" },
+  });
+
+  const pending = getPendingById().get(captured.id);
+  assert.ok(pending);
+  const pendingRows = buildCallLogListRows({
+    logs: [],
+    connections: [],
+    pendingDetails: [pending],
+    completedDetails: [],
+    now: pending.startedAt,
+  });
+  assert.deepEqual(
+    pendingRows.map((row) => ({
+      requestedServiceTier: row.requestedServiceTier,
+      reasoningEffortUpstream: row.reasoningEffortUpstream,
+    })),
+    [{ requestedServiceTier: "priority", reasoningEffortUpstream: "high" }]
+  );
+
+  finalizePendingRequestById(captured.id, { status: 200 });
+  const completedRows = buildCallLogListRows({
+    logs: [],
+    connections: [],
+    pendingDetails: [],
+    completedDetails: getCompletedDetails().values(),
+    now: Date.now(),
+  });
+  assert.equal(completedRows[0]?.requestedServiceTier, "priority");
+  assert.equal(completedRows[0]?.reasoningEffortUpstream, "high");
+
+  await saveCallLog({
+    id: "persisted-stream",
+    method: "POST",
+    path: "/v1/responses",
+    status: 200,
+    model: "gpt-5",
+    provider: "codex",
+    connectionId: "connection",
+    duration: 1,
+    tokens: { in: 1, out: 1 },
+    clientRequestBody: { reasoning_effort: "low", service_tier: "priority" },
+    upstreamRequestBody: { reasoning: { effort: "high" }, service_tier: "priority" },
+    reasoningEffortUpstream: captured.reasoningEffortUpstream(),
+    requestedServiceTier: captured.requestedServiceTier(),
+    responseBody: { choices: [{ message: { content: "ok" } }] },
+  });
+  await saveCallLog({
+    id: "legacy-unknown",
+    method: "POST",
+    path: "/v1/responses",
+    status: 500,
+    model: "gpt-5",
+    provider: "codex",
+    clientRequestBody: { reasoning_effort: "xhigh", service_tier: "priority" },
+    upstreamRequestBody: null,
+    responseBody: { error: "local failure" },
+  });
+
+  const db = core.getDbInstance();
+  const persistedDatabaseRow = db
+    .prepare(
+      "SELECT requested_service_tier, reasoning_effort_upstream, reasoning_source FROM call_logs WHERE id = ?"
+    )
+    .get("persisted-stream") as {
+    requested_service_tier: string | null;
+    reasoning_effort_upstream: string | null;
+    reasoning_source: string | null;
+  };
+  assert.equal(persistedDatabaseRow.requested_service_tier, "priority");
+  assert.equal(persistedDatabaseRow.reasoning_effort_upstream, "high");
+  assert.notEqual(persistedDatabaseRow.reasoning_source, "encrypted");
+  assert.deepEqual(
+    db
+      .prepare(
+        "SELECT requested_service_tier, reasoning_effort_upstream FROM call_logs WHERE id = ?"
+      )
+      .get("legacy-unknown"),
+    { requested_service_tier: null, reasoning_effort_upstream: null }
+  );
+
+  const persistedRows = buildCallLogListRows({
+    logs: await getCallLogs({ limit: 10 }),
+    connections: [],
+    pendingDetails: [],
+    completedDetails: [],
+  });
+  const persisted = persistedRows.find((row) => row.id === "persisted-stream");
+  assert.equal(persisted?.requestedServiceTier, "priority");
+  assert.equal(persisted?.reasoningEffortUpstream, "high");
+  const legacy = persistedRows.find((row) => row.id === "legacy-unknown");
+  assert.equal(legacy?.requestedServiceTier, null);
+  assert.equal(legacy?.reasoningEffortUpstream, null);
+});
diff --git a/tests/unit/migration-226-log-badge-bridge.test.ts b/tests/unit/migration-226-log-badge-bridge.test.ts
new file mode 100644
index 0000000000..7a11294655
--- /dev/null
+++ b/tests/unit/migration-226-log-badge-bridge.test.ts
@@ -0,0 +1,195 @@
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { SqliteAdapter } from "../../src/lib/db/adapters/types.ts";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-migration-226-"));
+const previousDataDir = process.env.DATA_DIR;
+process.env.DATA_DIR = dataDir;
+
+/** Downstream migration name; it occupied 213 in v3.8.52 and 226 in the v3.8.53 rebuild. */
+const DOWNSTREAM_NAME = "call_logs_requested_service_tier";
+const DOWNSTREAM_VERSION = "20261120120000";
+const OFFICIAL_213 = "api_key_preferred_connections";
+const OFFICIAL_226 = "request_cost_ledger_read_indexes";
+const LEGACY_213 = `legacy-213-${DOWNSTREAM_NAME}`;
+const LEGACY_226 = `legacy-226-${DOWNSTREAM_NAME}`;
+
+type Db = SqliteAdapter;
+type CoreModule = { getDbInstance(): Db; resetDbInstance(): void };
+let core: CoreModule;
+
+function hasColumn(db: Db, table: string, column: string): boolean {
+  return db
+    .prepare<{ name: string }>(`PRAGMA table_info(${table})`)
+    .all()
+    .some((entry) => entry.name === column);
+}
+
+function ledgerName(db: Db, version: string): string | undefined {
+  return db
+    .prepare<{ name: string }>("SELECT name FROM _omniroute_migrations WHERE version = ?")
+    .get(version)?.name;
+}
+
+function ledgerCount(db: Db, version: string): number {
+  return (
+    db
+      .prepare<{ count: number }>("SELECT COUNT(*) AS count FROM _omniroute_migrations WHERE version = ?")
+      .get(version)?.count ?? 0
+  );
+}
+
+function hasIndex(db: Db, name: string): boolean {
+  return (
+    db.prepare("SELECT 1 FROM sqlite_master WHERE type = 'index' AND name = ?").get(name) !==
+    undefined
+  );
+}
+
+function ledgerSnapshot(db: Db): string[] {
+  return db
+    .prepare<{ version: string; name: string }>("SELECT version, name FROM _omniroute_migrations")
+    .all()
+    .map((row) => `${row.version}:${row.name}`)
+    .sort();
+}
+
+/** Closes the singleton so the next read runs the full boot path (schema healers + migrations). */
+function boot(): Db {
+  core.resetDbInstance();
+  return core.getDbInstance();
+}
+
+function insertCallLog(db: Db, id: string, tier: string): void {
+  db.prepare(
+    "INSERT INTO call_logs (id, timestamp, status, model, requested_service_tier) VALUES (?, ?, ?, ?, ?)"
+  ).run(id, new Date().toISOString(), 200, "gpt-5-codex", tier);
+}
+
+function callLogTier(db: Db, id: string): string | null {
+  return (
+    db
+      .prepare<{ requested_service_tier: string | null }>(
+        "SELECT requested_service_tier FROM call_logs WHERE id = ?"
+      )
+      .get(id)?.requested_service_tier ?? null
+  );
+}
+
+function insertApiKey(db: Db, id: string, preferredConnections: string): void {
+  db.prepare(
+    "INSERT INTO api_keys (id, name, key, created_at, preferred_connections) VALUES (?, ?, ?, ?, ?)"
+  ).run(id, id, `${id}-secret`, new Date().toISOString(), preferredConnections);
+}
+
+function preferredConnections(db: Db, id: string): string | null {
+  return (
+    db
+      .prepare<{ preferred_connections: string | null }>(
+        "SELECT preferred_connections FROM api_keys WHERE id = ?"
+      )
+      .get(id)?.preferred_connections ?? null
+  );
+}
+
+before(async () => {
+  // Dynamic import by design: core.ts resolves DATA_DIR at module load, so the test must
+  // point it at its own temp directory first.
+  core = await import("../../src/lib/db/core.ts");
+});
+after(() => {
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+  if (previousDataDir === undefined) delete process.env.DATA_DIR;
+  else process.env.DATA_DIR = previousDataDir;
+});
+
+test("a fresh boot records official 226 and the timestamped downstream migration side by side", () => {
+  const db = core.getDbInstance();
+
+  assert.equal(ledgerName(db, "213"), OFFICIAL_213);
+  assert.equal(ledgerName(db, "226"), OFFICIAL_226);
+  assert.equal(ledgerCount(db, "226"), 1);
+  assert.equal(ledgerName(db, DOWNSTREAM_VERSION), DOWNSTREAM_NAME);
+  assert.equal(ledgerName(db, LEGACY_213), undefined);
+  assert.equal(ledgerName(db, LEGACY_226), undefined);
+  assert.ok(hasColumn(db, "api_keys", "preferred_connections"));
+  assert.ok(hasColumn(db, "call_logs", "requested_service_tier"));
+  assert.ok(hasIndex(db, "idx_rcl_request_id"), "official 226 built its indexes");
+});
+
+test("a fork.6 ledger that recorded the tier column at 213 is rehomed so official 213 applies", () => {
+  let db = core.getDbInstance();
+  insertCallLog(db, "fork6-log", "priority");
+
+  // Durable fork.6 state: the downstream migration owns slot 213, official 213 never ran (so
+  // api_keys has no preferred_connections), and the timestamped rebuild did not exist yet.
+  db.exec(`
+    DELETE FROM _omniroute_migrations WHERE version IN ('${DOWNSTREAM_VERSION}', '${LEGACY_213}');
+    UPDATE _omniroute_migrations SET name = '${DOWNSTREAM_NAME}' WHERE version = '213';
+    ALTER TABLE api_keys DROP COLUMN preferred_connections;
+  `);
+  assert.equal(ledgerName(db, "213"), DOWNSTREAM_NAME);
+  assert.equal(hasColumn(db, "api_keys", "preferred_connections"), false);
+
+  db = boot();
+
+  assert.equal(ledgerName(db, "213"), OFFICIAL_213, "official 213 re-ran on the released slot");
+  assert.equal(ledgerName(db, LEGACY_213), DOWNSTREAM_NAME, "the downstream row was preserved");
+  assert.ok(hasColumn(db, "api_keys", "preferred_connections"), "official 213 re-created its column");
+  assert.equal(ledgerName(db, DOWNSTREAM_VERSION), DOWNSTREAM_NAME);
+  assert.equal(callLogTier(db, "fork6-log"), "priority", "stored tier values survive the rehome");
+});
+
+test("a deployed fork.3 ledger that recorded the tier column at 226 keeps its rows while both 226 migrations run", () => {
+  let db = core.getDbInstance();
+  insertCallLog(db, "fork3-log", "flex");
+  insertApiKey(db, "fork3-key", '["connection-a"]');
+
+  // Deployed fork.3 state: official 213 already ran, but slot 226 holds the downstream tier
+  // migration, official 226 never ran (drop its indexes), and the timestamped file is new.
+  db.exec(`
+    DELETE FROM _omniroute_migrations WHERE version IN ('${LEGACY_226}', '${DOWNSTREAM_VERSION}');
+    UPDATE _omniroute_migrations SET name = '${DOWNSTREAM_NAME}' WHERE version = '226';
+    DROP INDEX IF EXISTS idx_rcl_api_key_ts_cover;
+    DROP INDEX IF EXISTS idx_rcl_request_id;
+  `);
+  assert.equal(ledgerName(db, "226"), DOWNSTREAM_NAME);
+  assert.equal(hasIndex(db, "idx_rcl_request_id"), false);
+
+  db = boot();
+
+  assert.equal(ledgerName(db, "213"), OFFICIAL_213);
+  assert.equal(ledgerName(db, "226"), OFFICIAL_226, "official 226 re-ran on the released slot");
+  assert.equal(ledgerCount(db, "226"), 1, "exactly one 226 ledger row remains");
+  assert.equal(ledgerName(db, LEGACY_226), DOWNSTREAM_NAME, "the downstream row was preserved");
+  assert.equal(
+    ledgerName(db, DOWNSTREAM_VERSION),
+    DOWNSTREAM_NAME,
+    "the timestamped migration applied"
+  );
+  assert.ok(hasIndex(db, "idx_rcl_api_key_ts_cover"), "official 226 re-created its covering index");
+  assert.ok(hasIndex(db, "idx_rcl_request_id"), "official 226 re-created its request-id index");
+  assert.equal(callLogTier(db, "fork3-log"), "flex", "stored tier values survive the replay");
+  assert.equal(
+    preferredConnections(db, "fork3-key"),
+    '["connection-a"]',
+    "api_keys.preferred_connections values survive the downstream migration replay"
+  );
+});
+
+test("an already-migrated database re-boots without re-running or dropping anything", () => {
+  const db = core.getDbInstance();
+  const before = ledgerSnapshot(db);
+
+  const rebooted = boot();
+
+  assert.deepEqual(ledgerSnapshot(rebooted), before);
+  assert.equal(ledgerCount(rebooted, "226"), 1);
+  assert.equal(ledgerName(rebooted, LEGACY_226), DOWNSTREAM_NAME);
+  assert.equal(callLogTier(rebooted, "fork3-log"), "flex");
+  assert.equal(preferredConnections(rebooted, "fork3-key"), '["connection-a"]');
+});
