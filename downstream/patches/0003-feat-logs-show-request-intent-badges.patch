+import React from "react";
+import { cleanup, render, screen, within } from "@testing-library/react";
+import { NextIntlClientProvider } from "next-intl";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import RequestLoggerV2 from "../../src/shared/components/RequestLoggerV2";
+import { computeLogsSignature } from "../../src/shared/components/requestLoggerSignature";
+import messages from "../../src/i18n/messages/en.json";
+
+vi.mock("next/navigation", () => ({ useRouter: () => ({ push: vi.fn() }) }));
+vi.mock("../../src/shared/components/RequestLoggerDetail", () => ({ default: () => null }));
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  localStorage.clear();
+});
+
+const baseRow = {
+  id: "row-1",
+  model: "codex-model",
+  provider: "codex",
+  status: 200,
+  duration: 100,
+  timestamp: "2026-01-01T00:00:00.000Z",
+  tokens: { in: 10, out: 20 },
+};
+
+function renderLogRows(rows: Record<string, unknown>[]) {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (url: string) => {
+      const body = url.startsWith("/api/usage/call-logs?")
+        ? rows
+        : url === "/api/provider-nodes"
+          ? { nodes: [] }
+          : {};
+      return new Response(JSON.stringify(body), { status: 200 });
+    })
+  );
+
+  return render(
+    <NextIntlClientProvider locale="en" timeZone="UTC" messages={messages}>
+      <RequestLoggerV2 />
+    </NextIntlClientProvider>
+  );
+}
+
+describe("request-intent badges", () => {
+  it("includes both serialized request-intent fields in the polling signature", () => {
+    const priorityHigh = {
+      ...baseRow,
+      requestedServiceTier: "priority",
+      reasoningEffortUpstream: "high",
+    };
+
+    expect(computeLogsSignature([priorityHigh])).toBe(computeLogsSignature([{ ...priorityHigh }]));
+    expect(computeLogsSignature([priorityHigh])).not.toBe(
+      computeLogsSignature([{ ...priorityHigh, requestedServiceTier: null }])
+    );
+    expect(computeLogsSignature([priorityHigh])).not.toBe(
+      computeLogsSignature([{ ...priorityHigh, reasoningEffortUpstream: "xhigh" }])
+    );
+  });
+
+  it("renders Fast and a known reasoning effort together, never for flex/default or unknown intent", async () => {
+    renderLogRows([
+      {
+        ...baseRow,
+        requestedServiceTier: "priority",
+        reasoningEffortUpstream: "high",
+      },
+      {
+        ...baseRow,
+        id: "flex",
+        model: "flex-model",
+        requestedServiceTier: "flex",
+        reasoningEffortUpstream: "xhigh",
+      },
+      {
+        ...baseRow,
+        id: "default",
+        model: "default-model",
+        requestedServiceTier: "default",
+        reasoningEffortUpstream: null,
+      },
+      {
+        ...baseRow,
+        id: "unknown",
+        model: "unknown-model",
+        requestedServiceTier: null,
+        reasoningEffortUpstream: "unknown",
+      },
+    ]);
+
+    const fast = await screen.findByRole("img", { name: "Fast requested" });
+    const fastCell = fast.closest("td");
+    expect(fastCell).not.toBeNull();
+    expect(within(fastCell!).getByText("codex-model")).toBeTruthy();
+    expect(within(fastCell!).getByTitle("Reasoning effort sent upstream").textContent).toBe("high");
+
+    expect(screen.getByText("xhigh")).toBeTruthy();
+    const modelBadges = screen
+      .getAllByTitle("Reasoning effort sent upstream")
+      .filter((element) => element.closest("td"));
+    expect(modelBadges.map((element) => element.textContent)).toEqual(["high", "xhigh"]);
+    expect(screen.queryAllByRole("img", { name: "Fast requested" })).toHaveLength(1);
+    expect(screen.queryByText("unknown", { exact: true })).toBeNull();
+  });
+});
