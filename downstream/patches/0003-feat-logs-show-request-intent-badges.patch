+  assert.equal(completedRows[0]?.requestedServiceTier, "priority");
+  assert.equal(completedRows[0]?.reasoningEffortUpstream, "high");
+
+  await saveCallLog({
+    id: "persisted-stream",
+    method: "POST",
+    path: "/v1/responses",
+    status: 200,
+    model: "gpt-5",
+    provider: "codex",
+    connectionId: "connection",
+    duration: 1,
+    tokens: { in: 1, out: 1 },
