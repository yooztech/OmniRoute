+  assert.equal(persistedDatabaseRow.requested_service_tier, "priority");
+  assert.equal(persistedDatabaseRow.reasoning_effort_upstream, "high");
+  assert.notEqual(persistedDatabaseRow.reasoning_source, "encrypted");
+  assert.deepEqual(
+    db
+      .prepare(
+        "SELECT requested_service_tier, reasoning_effort_upstream FROM call_logs WHERE id = ?"
+      )
