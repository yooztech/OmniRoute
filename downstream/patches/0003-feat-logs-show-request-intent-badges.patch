+import React from "react";
+import { cleanup, render, screen, within } from "@testing-library/react";
+import { NextIntlClientProvider } from "next-intl";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import RequestLoggerV2 from "../../src/shared/components/RequestLoggerV2";
+import { computeLogsSignature } from "../../src/shared/components/requestLoggerSignature";
+import { reportedCacheShare } from "../../src/shared/utils/usageDisplay";
+import messages from "../../src/i18n/messages/en.json";
+
+vi.mock("next/navigation", () => ({ useRouter: () => ({ push: vi.fn() }) }));
+vi.mock("../../src/shared/components/RequestLoggerDetail", () => ({ default: () => null }));
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  localStorage.clear();
+});
+
+const baseRow = {
+  id: "row-1",
+  model: "codex-model",
+  provider: "codex",
+  status: 200,
+  duration: 100,
+  timestamp: "2026-01-01T00:00:00.000Z",
+  tokens: { in: 10, out: 20 },
+};
+
+function renderLogRows(rows: Record<string, unknown>[]) {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (url: string) => {
+      const body = url.startsWith("/api/usage/call-logs?")
+        ? rows
+        : url === "/api/provider-nodes"
+          ? { nodes: [] }
+          : {};
+      return new Response(JSON.stringify(body), { status: 200 });
+    })
+  );
+
+  return render(
+    <NextIntlClientProvider locale="en" timeZone="UTC" messages={messages}>
+      <RequestLoggerV2 />
+    </NextIntlClientProvider>
+  );
+}
+
+describe("request-intent badges", () => {
+  it("includes both serialized request-intent fields in the polling signature", () => {
+    const priorityHigh = {
+      ...baseRow,
+      requestedServiceTier: "priority",
+      reasoningEffortUpstream: "high",
+    };
+
+    expect(computeLogsSignature([priorityHigh])).toBe(computeLogsSignature([{ ...priorityHigh }]));
+    expect(computeLogsSignature([priorityHigh])).not.toBe(
+      computeLogsSignature([{ ...priorityHigh, requestedServiceTier: null }])
+    );
+    expect(computeLogsSignature([priorityHigh])).not.toBe(
+      computeLogsSignature([{ ...priorityHigh, reasoningEffortUpstream: "xhigh" }])
+    );
+  });
+
+  it("renders Fast and a known reasoning effort together, never for flex/default or unknown intent", async () => {
+    renderLogRows([
+      {
+        ...baseRow,
+        requestedServiceTier: "priority",
+        reasoningEffortUpstream: "high",
+      },
+      {
+        ...baseRow,
+        id: "flex",
+        model: "flex-model",
+        requestedServiceTier: "flex",
+        reasoningEffortUpstream: "xhigh",
+      },
+      {
+        ...baseRow,
+        id: "default",
+        model: "default-model",
+        requestedServiceTier: "default",
+        reasoningEffortUpstream: null,
+      },
+      {
+        ...baseRow,
+        id: "unknown",
+        model: "unknown-model",
+        requestedServiceTier: null,
+        reasoningEffortUpstream: "unknown",
+      },
+    ]);
+
+    const fast = await screen.findByRole("img", { name: "Fast requested" });
+    expect(fast.tagName.toLowerCase()).toBe("svg");
+    expect(fast.querySelector("path")).not.toBeNull();
+    expect(screen.queryByText("bolt", { exact: true })).toBeNull();
+    const fastCell = fast.closest("td");
+    expect(fastCell).not.toBeNull();
+    expect(within(fastCell!).getByText("codex-model")).toBeTruthy();
+    const description = "Reasoning effort sent upstream, not the actual number of reasoning tokens";
+    expect(within(fastCell!).getByLabelText(`${description}: high`).textContent).toBe("high");
+    expect(screen.getByLabelText(`${description}: xhigh`).textContent).toBe("xhigh");
+    const modelBadges = screen
+      .getAllByTitle(description)
+      .filter((element) => element.closest("td"));
+    expect(modelBadges.map((element) => element.textContent)).toEqual(["high", "xhigh"]);
+    expect(screen.queryAllByRole("img", { name: "Fast requested" })).toHaveLength(1);
+    expect(screen.queryByText("unknown", { exact: true })).toBeNull();
+  });
+});
+
+describe("cache reuse percentage in the token cell", () => {
+  const reported = { source: "reported" } as const;
+
+  it("derives a rate only when input and cache read are both reported", () => {
+    const tokens = { in: 1000, cacheRead: 450 };
+    expect(reportedCacheShare(tokens, { input: reported, cacheRead: reported })).toBe(45);
+    expect(
+      reportedCacheShare(tokens, { input: reported, cacheRead: { source: "estimated" } })
+    ).toBe(null);
+    expect(reportedCacheShare(tokens, { input: { source: "unknown" }, cacheRead: reported })).toBe(
+      null
+    );
+    expect(reportedCacheShare(tokens, { input: reported, cacheRead: null })).toBe(null);
+    expect(
+      reportedCacheShare({ in: 1000, cacheRead: 1000 }, { input: reported, cacheRead: reported })
+    ).toBe(100);
+    expect(
+      reportedCacheShare({ in: 1000, cacheRead: 0 }, { input: reported, cacheRead: reported })
+    ).toBe(0);
+  });
+
+  it("refuses contradictory or missing operands instead of clamping them", () => {
+    const reported = { source: "reported" } as const;
+    const evidence = { input: reported, cacheRead: reported };
+    expect(reportedCacheShare({ in: 100, cacheRead: 150 }, evidence)).toBe(null);
+    expect(reportedCacheShare({ in: 0, cacheRead: 0 }, evidence)).toBe(null);
+    expect(reportedCacheShare({ in: -5, cacheRead: 1 }, evidence)).toBe(null);
+    expect(reportedCacheShare({ in: 100, cacheRead: -1 }, evidence)).toBe(null);
+    expect(reportedCacheShare({ in: 100, cacheRead: null }, evidence)).toBe(null);
+    expect(reportedCacheShare({ in: 100 }, evidence)).toBe(null);
+    expect(reportedCacheShare({}, evidence)).toBe(null);
+    expect(reportedCacheShare(null, evidence)).toBe(null);
+  });
+
+  it("renders the reported rate in the row and omits it without reported evidence", async () => {
+    const reportedRow = {
+      ...baseRow,
+      id: "reported",
+      model: "reported-model",
+      tokens: { in: 2000, out: 50, cacheRead: 1500 },
+      usageEvidence: {
+        input: { source: "reported" },
+        output: { source: "reported" },
+        cacheRead: { source: "reported" },
+        cacheCreation: { source: "reported" },
+      },
+    };
+    const estimatedRow = {
+      ...baseRow,
+      id: "estimated",
+      model: "estimated-model",
+      tokens: { in: 2000, out: 50, cacheRead: 1500 },
+      usageEvidence: {
+        input: { source: "estimated", method: "chars/4" },
+        output: { source: "reported" },
+        cacheRead: { source: "reported" },
+        cacheCreation: { source: "reported" },
+      },
+    };
+    const historicalRow = {
+      ...baseRow,
+      id: "historical",
+      model: "historical-model",
+      tokens: { in: 2000, out: 50, cacheRead: 1500 },
+      usageEvidence: null,
+    };
+
+    renderLogRows([reportedRow, estimatedRow, historicalRow]);
+    await screen.findByLabelText("Cache Reuse Ratio: 75%");
+
+    const rowOf = (model: string) =>
+      Array.from(document.querySelectorAll("tbody tr")).find((candidate) =>
+        candidate.textContent?.includes(model)
+      );
+    const reportedRowEl = rowOf("reported-model");
+    expect(reportedRowEl?.textContent).toContain("CR: 1,500 (reported)");
+    expect(reportedRowEl?.textContent).toContain("75%");
+    expect(
+      screen.getByLabelText("Cache Reuse Ratio: 75%", { selector: "span", exact: true })
+    ).toBeTruthy();
+    expect(rowOf("estimated-model")?.textContent).toContain("CR: 1,500 (reported)");
+    expect(rowOf("estimated-model")?.textContent).not.toContain("75%");
+    expect(rowOf("historical-model")?.textContent).not.toContain("75%");
+    expect(screen.getAllByLabelText(/^Cache Reuse Ratio:/)).toHaveLength(1);
+  });
+});
