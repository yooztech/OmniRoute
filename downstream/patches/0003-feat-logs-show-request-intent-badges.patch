@@ -0,0 +1,204 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { Capture } from "../../open-sse/utils/providerRequestLogging.ts";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "log-badge-lifecycle-"));
+process.env.DATA_DIR = dataDir;
+
+// These modules read DATA_DIR during initialization, so test isolation requires lazy loading.
+const core = await import("../../src/lib/db/core.ts");
+const { saveCallLog, getCallLogs } = await import("../../src/lib/usage/callLogs.ts");
+const { buildCallLogListRows } = await import("../../src/app/api/usage/call-logs/route.ts");
+const {
+  clearPendingRequests,
+  finalizePendingRequestById,
+  getCompletedDetails,
+  getPendingById,
+  trackPendingRequest,
+} = await import("../../src/lib/usage/usageHistory.ts");
+const { createPreparedRequestLogger } = await import(
+  "../../open-sse/utils/providerRequestLogging.ts"
+);
+
+test.after(() => {
+  clearPendingRequests();
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+});
+
+test.afterEach(() => {
+  clearPendingRequests();
+});
+
+function startCapturedRequest(provider = "codex") {
+  const id = trackPendingRequest("gpt-5", provider, "connection", true, {});
+  assert.ok(id);
+  let requestedServiceTier: string | null = null;
+  let reasoningEffortUpstream: string | null = null;
+  const capture = createPreparedRequestLogger(
+    { logTargetRequest() {} },
+    { id, model: "gpt-5", provider, connectionId: "connection" },
+    (tier) => {
+      requestedServiceTier = tier;
+    },
+    (effort) => {
+      reasoningEffortUpstream = effort;
+    }
+  );
+  return {
+    id,
+    capture,
+    requestedServiceTier: () => requestedServiceTier,
+    reasoningEffortUpstream: () => reasoningEffortUpstream,
+  };
+}
+
+async function captureBody(capture: Capture, body: Record<string, unknown>) {
+  await capture.capture({
+    url: "https://api.openai.test/v1/responses",
+    headers: { "content-type": "application/json" },
+    body,
+    bodyString: JSON.stringify(body),
+  });
+}
+
+test("captured upstream Codex intent updates the owned pending request and later capture replaces or clears it", async () => {
+  const request = startCapturedRequest();
+
+  await captureBody(request.capture, {
+    service_tier: "priority",
+    reasoning: { effort: "high" },
+  });
+  assert.equal(request.requestedServiceTier(), "priority");
+  assert.equal(request.reasoningEffortUpstream(), "high");
+  const firstPending = getPendingById().get(request.id);
+  assert.equal(firstPending?.requestedServiceTier, "priority");
+  assert.equal(firstPending?.reasoningEffortUpstream, "high");
+  await captureBody(request.capture, {
+    service_tier: "flex",
+    reasoning_effort: "xhigh",
+  });
+  assert.equal(request.requestedServiceTier(), "flex");
+  const replacedPending = getPendingById().get(request.id);
+  assert.equal(replacedPending?.requestedServiceTier, "flex");
+  assert.equal(replacedPending?.reasoningEffortUpstream, "xhigh");
+  await captureBody(request.capture, { service_tier: "default" });
+  assert.equal(request.requestedServiceTier(), "default");
+  assert.equal(request.reasoningEffortUpstream(), null);
+  const clearedPending = getPendingById().get(request.id);
+  assert.equal(clearedPending?.requestedServiceTier, "default");
+  assert.equal(clearedPending?.reasoningEffortUpstream, null);
+  await captureBody(request.capture, {});
+  assert.equal(getPendingById().get(request.id)?.requestedServiceTier, null);
+  assert.equal(getPendingById().get(request.id)?.reasoningEffortUpstream, null);
+
+  const nonCodex = startCapturedRequest("openai");
+  await captureBody(nonCodex.capture, {
+    service_tier: "priority",
+    reasoning: { effort: "high" },
+  });
+  assert.equal(nonCodex.requestedServiceTier(), null);
+  assert.equal(nonCodex.reasoningEffortUpstream(), "high");
+});
