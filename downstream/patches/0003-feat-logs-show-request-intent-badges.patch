+  assert.equal(persisted?.requestedServiceTier, "priority");
+  assert.equal(persisted?.reasoningEffortUpstream, "high");
+  const legacy = persistedRows.find((row) => row.id === "legacy-unknown");
+  assert.equal(legacy?.requestedServiceTier, null);
+  assert.equal(legacy?.reasoningEffortUpstream, null);
