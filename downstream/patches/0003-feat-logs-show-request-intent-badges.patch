@@ -0,0 +1,24 @@
+import { CANONICAL_EFFORT_VALUES } from "./effortStandardization";
+
+const UPSTREAM_EFFORTS = new Set<string>([...CANONICAL_EFFORT_VALUES, "minimal", "ultra"]);
+
+/** Canonicalizes only effort values that the upstream request parser recognizes. */
+export function normalizeUpstreamReasoningEffort(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const effort = value.trim().toLowerCase();
+  return UPSTREAM_EFFORTS.has(effort) ? effort : null;
+}
+
+/** Reads only an explicit effort serialized in an upstream request body. */
+export function readUpstreamReasoningEffort(body: unknown): string | null {
+  if (!body || typeof body !== "object" || Array.isArray(body)) return null;
+
+  const record = body as Record<string, unknown>;
+  const nestedReasoning = record.reasoning;
+  const nestedEffort =
+    nestedReasoning && typeof nestedReasoning === "object" && !Array.isArray(nestedReasoning)
+      ? (nestedReasoning as Record<string, unknown>).effort
+      : undefined;
+  const raw = record.reasoning_effort !== undefined ? record.reasoning_effort : nestedEffort;
+  return normalizeUpstreamReasoningEffort(raw);
+}
diff --git a/src/shared/utils/usageDisplay.ts b/src/shared/utils/usageDisplay.ts
index 4afd0ccd14..c0cc9fd296 100644
--- a/src/shared/utils/usageDisplay.ts
+++ b/src/shared/utils/usageDisplay.ts
@@ -13,3 +13,28 @@ export function formatUsageCounter(
   const method = source === "estimated" && evidence?.method ? `: ${evidence.method}` : "";
   return `${value.toLocaleString()} (${t(source)}${method})`;
 }
+
+/**
+ * Share of prompt input served from provider cache, as a whole percentage.
+ *
+ * Only counters that both sides actually reported qualify. An estimated or
+ * unknown operand cannot form a ratio without inventing the denominator, and a
+ * cache read larger than the input is contradictory data rather than a 100%
+ * hit. Returns `null` for every one of those cases so callers render no rate.
+ */
+export function reportedCacheShare(
+  tokens: { in?: number | null; cacheRead?: number | null } | null | undefined,
+  evidence:
+    | { input?: { source: string } | null; cacheRead?: { source: string } | null }
+    | null
+    | undefined
+): number | null {
+  if (evidence?.input?.source !== "reported" || evidence?.cacheRead?.source !== "reported")
+    return null;
+  const input = tokens?.in;
+  const cacheRead = tokens?.cacheRead;
+  if (typeof input !== "number" || typeof cacheRead !== "number") return null;
+  if (!Number.isFinite(input) || !Number.isFinite(cacheRead)) return null;
+  if (input <= 0 || cacheRead < 0 || cacheRead > input) return null;
+  return Math.round((cacheRead / input) * 100);
+}
