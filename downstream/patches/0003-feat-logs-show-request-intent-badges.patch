+++ b/tests/unit/migration-226-log-badge-bridge.test.ts
@@ -0,0 +1,65 @@
+import { after, before, test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-migration-226-"));
+const previousDataDir = process.env.DATA_DIR;
+process.env.DATA_DIR = dataDir;
+let core: typeof import("../../src/lib/db/core.ts");
+
+function hasColumn(db: ReturnType<typeof core.getDbInstance>, table: string, column: string): boolean {
+  return (db.prepare(`PRAGMA table_info(${table})`).all() as Array<{ name: string }>).some(
+    (entry) => entry.name === column
+  );
+}
+
+before(async () => { core = await import("../../src/lib/db/core.ts"); });
+after(() => {
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+  if (previousDataDir === undefined) delete process.env.DATA_DIR;
+  else process.env.DATA_DIR = previousDataDir;
+});
+
+test("226 rehomes both pre-upgrade and deployed fork-213 ledgers without losing either migration", () => {
+  let db = core.getDbInstance();
+  assert.ok(hasColumn(db, "api_keys", "preferred_connections"));
+  assert.ok(hasColumn(db, "call_logs", "requested_service_tier"));
+
+  // Recreate the durable pre-upgrade fork.6 state: old 213 owns the tier column.
+  db.exec("DELETE FROM _omniroute_migrations WHERE version = '226'; ALTER TABLE api_keys DROP COLUMN preferred_connections");
+  db.prepare("UPDATE _omniroute_migrations SET name = ? WHERE version = '213'").run("call_logs_requested_service_tier");
+  core.resetDbInstance();
+  db = core.getDbInstance();
+  assert.ok(hasColumn(db, "api_keys", "preferred_connections"));
+  assert.ok(hasColumn(db, "call_logs", "requested_service_tier"));
+  assert.equal(db.prepare("SELECT name FROM _omniroute_migrations WHERE version = '213'").get()?.name, "api_key_preferred_connections");
+  assert.equal(db.prepare("SELECT name FROM _omniroute_migrations WHERE version = 'legacy-213-call_logs_requested_service_tier'").get()?.name, "call_logs_requested_service_tier");
+  assert.equal(db.prepare("SELECT name FROM _omniroute_migrations WHERE version = '226'").get()?.name, "call_logs_requested_service_tier");
+
+  // A running fork.1 deployment has already recorded 226, but still carries the old 213.
+  db.prepare("DELETE FROM _omniroute_migrations WHERE version = 'legacy-213-call_logs_requested_service_tier'").run();
+  db.prepare("UPDATE _omniroute_migrations SET name = ? WHERE version = '213'").run("call_logs_requested_service_tier");
+  core.resetDbInstance();
+  db = core.getDbInstance();
+  assert.equal(db.prepare("SELECT name FROM _omniroute_migrations WHERE version = '213'").get()?.name, "api_key_preferred_connections");
+  assert.equal(db.prepare("SELECT name FROM _omniroute_migrations WHERE version = 'legacy-213-call_logs_requested_service_tier'").get()?.name, "call_logs_requested_service_tier");
+  assert.equal(db.prepare("SELECT COUNT(*) AS count FROM _omniroute_migrations WHERE version = '226'").get()?.count, 1);
+
+
+  // Recreate an official-213 ledger that lacks only the downstream tier column.
+  db.exec("DELETE FROM _omniroute_migrations WHERE version = '226'; ALTER TABLE call_logs DROP COLUMN requested_service_tier");
+  db.prepare("UPDATE _omniroute_migrations SET name = ? WHERE version = '213'").run("api_key_preferred_connections");
+  db.prepare("DELETE FROM _omniroute_migrations WHERE version = 'legacy-213-call_logs_requested_service_tier'").run();
+  core.resetDbInstance();
+  db = core.getDbInstance();
+  assert.ok(hasColumn(db, "api_keys", "preferred_connections"));
+  assert.ok(hasColumn(db, "call_logs", "requested_service_tier"));
+  db.prepare("INSERT INTO api_keys (id, name, key, created_at, preferred_connections) VALUES (?, ?, ?, ?, ?)").run("bridge-key", "bridge-key", "bridge-key-secret", new Date().toISOString(), "[\"c1\"]");
+  assert.equal(db.prepare("SELECT preferred_connections FROM api_keys WHERE id = ?").get("bridge-key")?.preferred_connections, "[\"c1\"]");
+  core.resetDbInstance();
+  db = core.getDbInstance();
+  assert.equal(db.prepare("SELECT COUNT(*) AS count FROM _omniroute_migrations WHERE version = '226'").get()?.count, 1);
+});
