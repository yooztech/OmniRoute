     hasExhaustedUsageWindow(headers) ||
@@ -65,6 +66,15 @@ function hasExhaustedQuotaEvidence(headers: unknown): boolean {
   );
 }
 
+export function isCodexQuotaExhausted429(status: number, body: unknown, headers?: unknown): boolean {
+  return (
+    status === 429 &&
+    ((typeof body === "string" && QUOTA_EXHAUSTED_MESSAGE.test(body)) ||
+      hasExhaustedUsageWindow(headers) ||
+      hasExhaustedUsedPercent(headers))
+  );
+}
