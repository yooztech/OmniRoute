+for (const model of ["gpt-5.5", "gpt-5.3-codex-spark"]) {
+  test(`disableCooling skips transient ${model.includes("spark") ? "Spark" : "Codex"} scope writes but preserves quota protection`, async () => {
+    const connection = await seedCodexConnection(true);
+    const until = new Date(Date.now() + 60_000).toISOString();
+    const credentials = {
+      connectionId: connection.id,
+      providerSpecificData: connection.providerSpecificData,
+    };
+
+    await codexFailover.markCodexScopeRateLimited({
+      failedConnectionId: connection.id,
+      model,
+      rateLimitedUntil: until,
+      credentials,
+    });
+    let persisted = await readConnection(connection.id);
+    assert.equal(
+      persisted.providerSpecificData.codexScopeRateLimitedUntil,
+      undefined,
+      "transient 429 must not persist a virtual-child cooldown"
+    );
+
+    await codexFailover.markCodexScopeRateLimited({
+      failedConnectionId: connection.id,
+      model,
+      rateLimitedUntil: until,
+      quotaExhausted: true,
+      credentials,
+    });
+    persisted = await readConnection(connection.id);
+    const scope = model.includes("spark") ? "spark" : "codex";
+    assert.equal(persisted.providerSpecificData.codexScopeRateLimitedUntil[scope], until);
+  });
+}
