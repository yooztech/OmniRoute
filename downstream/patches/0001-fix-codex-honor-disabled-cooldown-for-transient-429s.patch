@@ -316,3 +317,171 @@ test("concurrent Codex and Spark child cooldown writes retain both scopes", asyn
   });
   assert.deepEqual(persisted.providerSpecificData.unrelated, { retained: true });
 });
+
+const childScopes = [
+  { scope: "codex", sibling: "spark", model: "gpt-5.5" },
+  { scope: "spark", sibling: "codex", model: "gpt-5.3-codex-spark" },
+] as const;
+
+function parentHealth(connection: SeededConnection) {
+  return {
+    testStatus: connection.testStatus,
+    rateLimitedUntil: connection.rateLimitedUntil,
+    lastError: connection.lastError,
+    errorCode: connection.errorCode,
+    backoffLevel: connection.backoffLevel,
+  };
+}
+
+for (const { scope, sibling, model } of childScopes) {
+  for (const existing of [false, true]) {
+    for (const entrypoint of ["direct", "failover"] as const) {
+      test(`disableCooling preserves ${scope} cooldown on ${entrypoint} writes (existing=${existing})`, async () => {
+        const oldUntil = new Date(Date.now() + 60_000).toISOString();
+        const siblingUntil = new Date(Date.now() + 90_000).toISOString();
+        const fallbackUntil = new Date(Date.now() + 300_000).toISOString();
+        const cooldowns = { [sibling]: siblingUntil, ...(existing ? { [scope]: oldUntil } : {}) };
+        const connection = await seedCodexConnection({
+          disableCooling: true,
+          codexScopeRateLimitedUntil: cooldowns,
+        });
+        const before = await readConnection(connection.id);
+        const credentials = {
+          connectionId: connection.id,
+          providerSpecificData: connection.providerSpecificData,
+        };
+        if (entrypoint === "direct") {
+          const direct = await codexAccount.persistCodexChildCooldown({
+            connectionId: connection.id,
+            model,
+            rateLimitedUntil: fallbackUntil,
+          });
+          assert.ok(direct);
+          assert.deepEqual(direct.providerSpecificData.codexScopeRateLimitedUntil, cooldowns);
+        } else {
+          // Temporary 429 failover reaches this writer without quota headers.
+          await codexFailover.markCodexScopeRateLimited({
+            failedConnectionId: connection.id,
+            model,
+            rateLimitedUntil: fallbackUntil,
+            credentials,
+          });
+        }
+        const persisted = await readConnection(connection.id);
+        assert.deepEqual(persisted.providerSpecificData.codexScopeRateLimitedUntil, cooldowns);
+        if (entrypoint === "failover")
+          assert.deepEqual(credentials.providerSpecificData, persisted.providerSpecificData);
+        assert.deepEqual(parentHealth(persisted), parentHealth(before));
+      });
+    }
+  }
+
+  test(`disableCooling still persists explicit body quota exhaustion for ${scope}`, async () => {
+    const connection = await seedCodexConnection({ disableCooling: true });
+    const until = new Date(Date.now() + 300_000).toISOString();
+    await codexAccount.persistCodexChildCooldown({
+      connectionId: connection.id,
+      model,
+      rateLimitedUntil: until,
+      quotaExhausted: true,
+    });
+    const persisted = await readConnection(connection.id);
+    assert.equal(
+      (persisted.providerSpecificData.codexScopeRateLimitedUntil as Record<string, unknown>)[scope],
+      until
+    );
+    assert.equal(
+      (persisted.providerSpecificData.codexScopeRateLimitSource as Record<string, unknown>)[scope],
+      "fallback"
+    );
+  });
+
+  test(`disableCooling saves non-exhausted ${scope} quota observations without fallback cooling`, async () => {
+    const oldUntil = new Date(Date.now() + 60_000).toISOString();
+    const siblingUntil = new Date(Date.now() + 90_000).toISOString();
+    const reset5h = new Date(Date.now() + 600_000).toISOString();
+    const reset7d = new Date(Date.now() + 1_200_000).toISOString();
+    const cooldowns = { [scope]: oldUntil, [sibling]: siblingUntil };
+    const connection = await seedCodexConnection({
+      disableCooling: true,
+      codexScopeRateLimitedUntil: cooldowns,
+    });
+    const before = await readConnection(connection.id);
+    const result = await codexAccount.persistCodexChildQuotaResponse({
+      connectionId: connection.id,
+      model,
+      headers: { ...quotaHeaders(reset5h, reset7d), "x-codex-5h-usage": "20" },
+      status: 429,
+      fallbackRateLimitedUntil: new Date(Date.now() + 300_000).toISOString(),
+    });
+    assert.ok(result);
+    const persisted = await readConnection(connection.id);
+    assert.deepEqual(persisted.providerSpecificData.codexScopeRateLimitedUntil, cooldowns);
+    assert.deepEqual(result.providerSpecificData, persisted.providerSpecificData);
+    const observations = persisted.providerSpecificData.codexQuotaStateByScope as Record<
+      string,
+      Record<string, unknown>
+    >;
+    assert.equal(observations[scope].usage5h, 20);
+    assert.equal(observations[scope].resetAt5h, reset5h);
+    assert.equal(observations[sibling], undefined);
+    assert.deepEqual(parentHealth(persisted), parentHealth(before));
+  });
+
+  for (const window of ["5h", "7d"] as const) {
+    test(`disableCooling retains exhausted ${scope} ${window} quota reset protection`, async () => {
+      const reset5h = new Date(Date.now() + 600_000).toISOString();
+      const reset7d = new Date(Date.now() + 1_200_000).toISOString();
+      const siblingUntil = new Date(Date.now() + 90_000).toISOString();
+      const connection = await seedCodexConnection({
+        disableCooling: true,
+        codexScopeRateLimitedUntil: { [sibling]: siblingUntil },
+      });
+      const before = await readConnection(connection.id);
+      const result = await codexAccount.persistCodexChildQuotaResponse({
+        connectionId: connection.id,
+        model,
+        headers: {
+          ...quotaHeaders(reset5h, reset7d, window === "7d" ? "100" : "10"),
+          "x-codex-5h-usage": window === "5h" ? "100" : "20",
+        },
+        status: 429,
+        fallbackRateLimitedUntil: new Date(Date.now() + 300_000).toISOString(),
+      });
+      assert.ok(result);
+      const persisted = await readConnection(connection.id);
+      assert.deepEqual(persisted.providerSpecificData.codexScopeRateLimitedUntil, {
+        [scope]: window === "5h" ? reset5h : reset7d,
+        [sibling]: siblingUntil,
+      });
+      assert.equal(
+        (persisted.providerSpecificData.codexScopeRateLimitSource as Record<string, unknown>)[
+          scope
+        ],
+        "quota_reset"
+      );
+      assert.equal(
+        (persisted.providerSpecificData.codexExhaustedWindowByScope as Record<string, unknown>)[
+          scope
+        ],
+        window
+      );
+      assert.deepEqual(result.providerSpecificData, persisted.providerSpecificData);
+      assert.deepEqual(parentHealth(persisted), parentHealth(before));
+    });
+  }
+
+  test(`disableCooling false permits ${scope} fallback cooling`, async () => {
+    const connection = await seedCodexConnection({ disableCooling: false });
+    const until = new Date(Date.now() + 60_000).toISOString();
+    const result = await codexAccount.persistCodexChildCooldown({
+      connectionId: connection.id,
+      model,
+      rateLimitedUntil: until,
+    });
+    assert.ok(result);
+    const persisted = await readConnection(connection.id);
+    assert.equal(persisted.providerSpecificData.codexScopeRateLimitedUntil[scope], until);
+    assert.deepEqual(result.providerSpecificData, persisted.providerSpecificData);
+  });
+}
