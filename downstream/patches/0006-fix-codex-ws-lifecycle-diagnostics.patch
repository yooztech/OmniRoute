+        events.push({ type: "send", data: message });
+        return;
+      }
+      this.bufferedAmount++;
+      setImmediate(() => {
+        events.push({ type: "send", data: message });
+        this.bufferedAmount--;
+      });
+    },
+    close() { events.push({ type: "close" }); },
+  };
+  const h = await harness(t, {
+    factory: async () => upstream,
+  });
+  h.send();
+  await waitFor(() => events.some((event) => event.type === "send"), "initial upstream send");
+  const message = { type: "input_audio_buffer.append", audio: "YWJj" };
+  const closeFrame = Buffer.from([0x88, 0x80, 1, 2, 3, 4]);
+  h.socket.emit("data", Buffer.concat([clientFrame(message), closeFrame]));
+  assert.equal(h.socket.writable, false, "downstream Close does not await the upstream write");
+  await waitFor(() => events.some((event) => event.type === "close"), "upstream close");
+  assert.deepEqual(events.slice(1), [{ type: "send", data: message }, { type: "close" }]);
