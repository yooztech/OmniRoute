+import test from "node:test";
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import { createResponsesWsProxy } from "../../scripts/dev/responses-ws-proxy.mjs";
+
+const secret = "credential-user:credential-password@private-host";
+const bodySecret = "private-prompt-body";
+const leak = `failure ${secret} ${bodySecret}`;
+const json = (value, status = 200) => new Response(JSON.stringify(value), { status });
+const prepared = {
+  upstreamUrl: "wss://upstream.invalid/responses",
+  headers: { authorization: `Bearer ${secret}` },
+  leaseId: "late-lease",
+  connectionId: "bound-account",
+  response: { model: "gpt-test", input: bodySecret },
+};
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((done) => { resolve = done; });
+  return { promise, resolve };
+}
+
+async function waitFor(predicate, description) {
+  const deadline = Date.now() + 3000;
+  while (!predicate()) {
+    if (Date.now() >= deadline) throw new Error(`Timed out waiting for ${description}`);
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+}
+
+function clientFrame(value) {
+  const payload = Buffer.from(JSON.stringify(value));
+  const header = payload.length < 126
+    ? Buffer.from([0x81, 0x80 | payload.length])
+    : payload.length <= 65535
+      ? Buffer.from([0x81, 0xfe, payload.length >> 8, payload.length & 255])
+      : Buffer.from([0x81, 0xff, 0, 0, 0, 0, 0, (payload.length >>> 16) & 255, (payload.length >>> 8) & 255, payload.length & 255]);
+  const mask = Buffer.from([1, 2, 3, 4]);
+  const encoded = Buffer.from(payload);
+  for (let i = 0; i < encoded.length; i++) encoded[i] ^= mask[i % 4];
+  return Buffer.concat([header, mask, encoded]);
+}
+
+function serverMessages(socket) {
+  return socket.writes.filter(Buffer.isBuffer).filter((frame) => (frame[0] & 15) === 1).map((frame) => {
+    let offset = 2;
+    let length = frame[1] & 127;
+    if (length === 126) { length = frame.readUInt16BE(2); offset = 4; }
+    else if (length === 127) { length = Number(frame.readBigUInt64BE(2)); offset = 10; }
+    return JSON.parse(frame.subarray(offset, offset + length).toString());
+  });
+}
+
+async function harness(t, { prepare, factory, log, maxBufferBytes, maxMessageBytes } = {}) {
+  const calls = [];
+  const warnings = [];
+  const originalWarn = console.warn;
+  console.warn = (...args) => warnings.push(args);
+  t.after(() => { console.warn = originalWarn; });
+  const socket = new EventEmitter();
+  Object.assign(socket, {
+    writes: [], destroyed: false, writable: true,
+    setNoDelay() {},
+    write(data) { this.writes.push(data); return true; },
+    end() { this.writable = false; this.emit("end"); },
+    destroy() { this.destroyed = true; this.emit("close"); },
+  });
+  t.after(() => socket.destroy());
+  const fetchImpl = async (_url, options) => {
+    const request = JSON.parse(options.body);
+    calls.push(request);
+    if (request.action === "prepare") return prepare ? prepare(request) : json(prepared);
+    if (request.action === "log") return log ? log(request) : json({});
+    return json({});
+  };
+  const proxy = createResponsesWsProxy({
+    baseUrl: "http://localhost:3000", bridgeSecret: secret, fetchImpl,
+    wsFactory: factory || (async () => ({ send() {}, close() {} })),
+    pingIntervalMs: 60000, maxBufferBytes, maxMessageBytes,
+  });
+  await proxy.handleUpgrade({
+    url: `/v1/responses?api_key=${encodeURIComponent(secret)}`,
+    headers: { upgrade: "websocket", "sec-websocket-key": "dGhlIHNhbXBsZSBub25jZQ==" },
+    socket: { remoteAddress: "127.0.0.1" },
+  }, socket, Buffer.alloc(0));
+  assert.match(socket.writes[0], /^HTTP\/1\.1 101 /);
+  return {
+    socket, calls, warnings,
+    send() { socket.emit("data", clientFrame({ type: "response.create", model: "gpt-test", input: bodySecret })); },
+  };
+}
+
+function assertWarning(warnings, stage) {
+  const matching = warnings.filter((args) => {
+    if (args.length !== 1 || typeof args[0] !== "string" || !args[0].startsWith("[responses-ws-proxy] ")) return false;
+    try { return JSON.parse(args[0].slice("[responses-ws-proxy] ".length)).stage === stage; } catch { return false; }
+  });
+  assert.equal(matching.length, 1, `expected one structured ${stage} warning`);
+  const text = matching[0][0];
+  const entry = JSON.parse(text.slice("[responses-ws-proxy] ".length));
+  assert.match(entry.sessionId, /^[0-9a-f-]{36}$/i);
+  assert.match(entry.code, /^[a-z][a-z0-9_]*$/);
+  assert.ok(!text.includes(secret));
+  assert.ok(!text.includes(bodySecret));
+  assert.ok(!text.includes("credential-password"));
+  assert.ok(!text.includes("private-host"));
+  assert.ok(!text.includes("failure "));
+  return entry;
+}
+
+test("downstream close during prepare releases late lease without connecting", { timeout: 5000 }, async (t) => {
+  const pending = deferred();
+  let connects = 0;
+  const h = await harness(t, { prepare: () => pending.promise, factory: async () => { connects++; return {}; } });
+  h.send();
+  await waitFor(() => h.calls.some((c) => c.action === "prepare"), "prepare");
+  h.socket.destroy();
+  pending.resolve(json(prepared));
+  await waitFor(() => h.calls.some((c) => c.action === "release"), "late lease release");
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(connects, 0);
+  assert.deepEqual(h.calls.filter((c) => c.action === "release").map((c) => c.leaseId), ["late-lease"]);
+});
+
+test("downstream close during connect closes late socket without sending", { timeout: 5000 }, async (t) => {
+  const pending = deferred();
+  let connects = 0;
+  let sends = 0;
+  let closes = 0;
+  const h = await harness(t, { factory: () => { connects++; return pending.promise; } });
+  h.send();
+  await waitFor(() => connects === 1, "upstream connect");
+  h.socket.destroy();
+  pending.resolve({ send() { sends++; }, close() { closes++; } });
+  await waitFor(() => closes === 1, "late upstream close");
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(sends, 0);
+  await waitFor(() => h.calls.some((c) => c.action === "release"), "lease release");
+  assert.equal(h.calls.filter((c) => c.action === "release").length, 1);
+});
+
+for (const field of ["connectionId", "leaseId"]) {
+  test(`changed ${field} during prepare never sends the next turn on the old socket`, async (t) => {
+    let turns = 0;
+    let sends = 0;
+    const h = await harness(t, {
+      prepare: () => json(++turns === 1 ? prepared : { ...prepared, [field]: "different" }),
+      factory: async () => ({ send() { sends++; }, close() {} }),
+    });
+    h.send();
+    await waitFor(() => sends === 1, "first upstream send");
+    h.send();
+    await waitFor(() => !h.socket.writable, "binding mismatch closes session");
+    assert.equal(sends, 1);
+    const releases = h.calls.filter((c) => c.action === "release").map((c) => c.leaseId).sort();
+    assert.deepEqual(releases, field === "leaseId" ? ["different", "late-lease"] : ["late-lease"]);
+    const failure = h.calls.find((c) => c.action === "log" && !c.success);
+    assert.equal(failure.connectionId, prepared.connectionId);
+  });
+}
+
+test(
+  "a WS Close frame split across TCP reads stops a pending upstream handshake",
+  { timeout: 5000 },
+  async (t) => {
+    const pending = deferred();
+    let connects = 0;
+    let sends = 0;
+    let closes = 0;
+    const h = await harness(t, {
+      factory: () => {
+        connects++;
+        return pending.promise;
+      },
+    });
+    h.send();
+    await waitFor(() => connects === 1, "upstream connect");
+
+    const closeFrame = Buffer.from([0x88, 0x80, 1, 2, 3, 4]);
+    h.socket.emit("data", closeFrame.subarray(0, 3));
+    assert.equal(h.socket.writable, true, "wait for the complete Close frame");
+    h.socket.emit("data", closeFrame.subarray(3));
+    const repliedBeforeConnect = !h.socket.writable;
+
+    pending.resolve({
+      send() {
+        sends++;
+      },
+      close() {
+        closes++;
+      },
+    });
+    await waitFor(() => closes === 1, "late upstream close");
+    assert.equal(sends, 0);
+    assert.equal(repliedBeforeConnect, true, "reply to Close while the handshake is still pending");
+    assert.equal(h.calls.filter((call) => call.action === "release").length, 1);
+  }
+);
+
+test("invalid downstream Close uses a transport-supported upstream close code", { timeout: 5000 }, async (t) => {
+  const closeCalls = [];
+  let upstream;
+  const h = await harness(t, {
+    factory: async () => (upstream = {
+      send() {},
+      close(code, reason) {
+        if (code !== 1000 && !(code >= 3000 && code <= 4999)) throw new Error("unsupported close code");
+        closeCalls.push({ code, reason });
