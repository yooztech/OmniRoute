diff --git a/tests/unit/authz/proxy-locality-behavior.test.ts b/tests/unit/authz/proxy-locality-behavior.test.ts
new file mode 100644
index 0000000000..3dca39c68c
--- /dev/null
+++ b/tests/unit/authz/proxy-locality-behavior.test.ts
@@ -0,0 +1,187 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import http from "node:http";
+import os from "node:os";
+import path from "node:path";
+import type { AddressInfo } from "node:net";
+
+const keys = [
+  "DATA_DIR",
+  "OMNIROUTE_PEER_STAMP_TOKEN",
+  "OMNIROUTE_TRUSTED_PROXIES",
+  "OMNIROUTE_DISABLE_CLI_TOKEN",
+] as const;
+const original = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-proxy-locality-"));
+process.env.DATA_DIR = dataDir;
+process.env.OMNIROUTE_PEER_STAMP_TOKEN = "proxy-locality-behavior-token";
+delete process.env.OMNIROUTE_TRUSTED_PROXIES;
+delete process.env.OMNIROUTE_DISABLE_CLI_TOKEN;
+
+// Import after setting DATA_DIR because database and token modules read it at load time.
+const {
+  stampPeerIp,
+  wrapRequestListenerWithPeerStamp,
+  PEER_IP_HEADER,
+  VIA_PROXY_HEADER,
+  CLIENT_IP_HEADER,
+  LOCALITY_CLIENT_IP_HEADER,
+} = await import("../../../scripts/dev/peer-stamp.mjs");
+const { classifyStampedPeerLocality } = await import("../../../src/server/authz/peerStamp.ts");
+const { isLoopbackRequest, isPrivateLanRequest, hasValidLoopbackCliToken } =
+  await import("../../../src/server/authz/peerContext.ts");
+const { managementPolicy } = await import("../../../src/server/authz/policies/management.ts");
+const { classifyRoute } = await import("../../../src/server/authz/classify.ts");
+const { getMachineTokenSync } = await import("../../../src/lib/machineToken.ts");
+const core = await import("../../../src/lib/db/core.ts");
+const token = "proxy-locality-behavior-token";
+
+test.after(() => {
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true });
+  for (const key of keys) {
+    if (original[key] === undefined) delete process.env[key];
+    else process.env[key] = original[key];
+  }
+});
+
+function stamped(peer: string | undefined, headers: Record<string, string>) {
+  const req = { socket: { remoteAddress: peer }, headers: { ...headers } };
+  stampPeerIp(req);
+  const h = req.headers as Record<string, string | undefined>;
+  return {
+    h,
+    locality: classifyStampedPeerLocality(
+      h[PEER_IP_HEADER] ?? null,
+      h[VIA_PROXY_HEADER] ?? null,
+      h[LOCALITY_CLIENT_IP_HEADER] ?? null,
+      token
+    ),
+  };
+}
+
+test("real stamping attributes trusted forwarding without trusting spoofed hops", () => {
+  for (const [peer, forwarded, expected] of [
+    ["127.0.0.1", "192.168.1.20", "lan"],
+    ["::1", "127.0.0.1", "lan"],
+    ["127.0.0.1", "fd00::5", "lan"],
+    ["127.0.0.1", "::ffff:192.168.1.20", "lan"],
+    ["127.0.0.1", "::ffff:c0a8:114", "lan"],
+    ["127.0.0.1", "2001:db8::5", "remote"],
+    ["127.0.0.1", "192.168.1.20, 203.0.113.7", "remote"],
+    ["203.0.113.7", "192.168.1.20", "remote"],
+    ["::ffff:203.0.113.7", "192.168.1.20", "remote"],
+  ]) {
+    assert.equal(
+      stamped(peer, { "x-forwarded-for": forwarded }).locality,
+      expected,
+      `${peer}: ${forwarded}`
+    );
+  }
+});
+
+test("missing and malformed forwarding cannot inherit the proxy's locality", () => {
+  const cases: Record<string, string>[] = [
+    { "x-forwarded-proto": "https" },
+    { "x-forwarded-for": "" },
+    { "x-forwarded-for": "invalid" },
+    { "x-forwarded-for": "192.168.1.5, invalid" },
+    { "x-real-ip": "192.168.1.5, invalid" },
+  ];
+  for (const headers of cases) {
+    const result = stamped("127.0.0.1", headers);
+    assert.equal(result.locality, "remote");
+    assert.equal(result.h[LOCALITY_CLIENT_IP_HEADER], undefined);
+  }
+  const missingPeer = stamped(undefined, { "x-forwarded-for": "192.168.1.5" });
+  assert.equal(missingPeer.locality, "remote");
+});
+
+test("producer overwrites forged stamps and retains the ordinary client-IP stamp", () => {
+  const result = stamped("127.0.0.1", {
+    "x-forwarded-for": "203.0.113.8",
+    [PEER_IP_HEADER]: `${token}|127.0.0.1`,
+    [VIA_PROXY_HEADER]: `${token}|0`,
+    [CLIENT_IP_HEADER]: `${token}|192.168.1.5`,
+    [LOCALITY_CLIENT_IP_HEADER]: `${token}|192.168.1.5`,
+  });
+  assert.equal(result.locality, "remote");
+  assert.equal(result.h[CLIENT_IP_HEADER], `${token}|203.0.113.8`);
+  assert.equal(result.h[LOCALITY_CLIENT_IP_HEADER], `${token}|203.0.113.8`);
+  assert.equal(stamped("127.0.0.1", {}).locality, "loopback");
+});
+
+test("HTTP listener applies management local-only and strict CLI boundaries", async () => {
+  const cliToken = getMachineTokenSync();
+  assert.ok(cliToken);
+  const server = http.createServer(
+    wrapRequestListenerWithPeerStamp(
+      async (req: http.IncomingMessage, res: http.ServerResponse) => {
+        try {
+          const headers = new Headers();
+          for (const [key, value] of Object.entries(req.headers)) {
+            if (value !== undefined)
+              headers.set(key, Array.isArray(value) ? value.join(", ") : value);
+          }
+          const route = "/api/cli-tools/runtime/status";
+          const ctx = {
+            request: { method: "GET", headers, url: `http://localhost${route}` },
+            classification: classifyRoute(route, "GET"),
+            requestId: "test",
+          };
+          const decision = await managementPolicy.evaluate(ctx);
+          res.end(
+            JSON.stringify({
+              decision,
+              loopback: isLoopbackRequest(ctx),
+              lan: isPrivateLanRequest(ctx),
+              cli: hasValidLoopbackCliToken(ctx),
+            })
+          );
+        } catch (error) {
+          res.statusCode = 500;
+          res.end(String(error));
+        }
+      }
+    )
+  );
+  const listening = Promise.withResolvers<void>();
+  server.listen(0, "127.0.0.1", listening.resolve);
+  await listening.promise;
+  const port = (server.address() as AddressInfo).port;
+  async function request(headers: Record<string, string>) {
+    const response = await fetch(`http://127.0.0.1:${port}/`, {
+      headers: { ...headers, "x-omniroute-cli-token": cliToken! },
+    });
+    assert.equal(response.status, 200, await response.clone().text());
+    return response.json() as Promise<{
+      decision: { allow: boolean; code?: string };
+      loopback: boolean;
+      lan: boolean;
+      cli: boolean;
+    }>;
+  }
+  try {
+    const direct = await request({});
+    assert.equal(direct.loopback, true);
+    assert.equal(direct.cli, true);
+    assert.equal(direct.decision.allow, true);
+    for (const ip of ["192.168.1.5", "127.0.0.1", "fd00::5"]) {
+      const proxied = await request({ "x-forwarded-for": ip });
+      assert.equal(proxied.loopback, false, ip);
+      assert.equal(proxied.lan, true, ip);
+      assert.equal(proxied.cli, false, ip);
+      assert.notEqual(proxied.decision.code, "LOCAL_ONLY", ip);
+    }
+    for (const ip of ["203.0.113.5", "invalid", ""]) {
+      const proxied = await request({ "x-forwarded-for": ip });
+      assert.equal(proxied.cli, false, ip);
+      assert.equal(proxied.decision.code, "LOCAL_ONLY", ip);
+    }
+  } finally {
+    const closed = Promise.withResolvers<void>();
+    server.close((error) => (error ? closed.reject(error) : closed.resolve()));
+    await closed.promise;
+  }
+});
