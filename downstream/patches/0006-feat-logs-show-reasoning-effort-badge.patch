@@ -0,0 +1,69 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "call-log-effort-"));
+process.env.DATA_DIR = dataDir;
+// These modules read DATA_DIR on import, so load them after selecting the isolated database.
+const core = await import("../../src/lib/db/core.ts");
+const { saveCallLog, getCallLogs } = await import("../../src/lib/usage/callLogs.ts");
+const { buildCallLogListRows } = await import("../../src/app/api/usage/call-logs/route.ts");
+const { createPreparedRequestLogger } = await import("../../open-sse/utils/providerRequestLogging.ts");
+const { trackPendingRequest, clearPendingRequests } = await import("../../src/lib/usage/usageHistory.ts");
+
+test.after(() => {
+  clearPendingRequests();
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+});
+
+test("non-encrypted call logs persist actual upstream effort and expose it in list rows", async () => {
+  const cases = [
+    ["responses", { reasoning: { effort: " HIGH " } }, "high"],
+    ["chat", { reasoning_effort: "minimal" }, "minimal"],
+    ["unknown", { reasoning_effort: "surprise" }, null],
+    ["invalid", { reasoning: { effort: 42 } }, null],
+    ["not-sent", { reasoning: { effort: "low" } }, null],
+    ["legacy", {}, null],
+  ] as const;
+  for (const [id, upstreamRequestBody] of cases) {
+    let reasoningEffortUpstream: string | null = null;
+    const pendingId = trackPendingRequest("model", "codex", "conn", true, {});
+    assert.ok(pendingId);
+    const capture = createPreparedRequestLogger(
+      { logTargetRequest() {} },
+      { id: pendingId, model: "model", provider: "codex", connectionId: "conn" },
+      undefined,
+      (effort) => { reasoningEffortUpstream = effort; }
+    );
+    if (id !== "not-sent" && id !== "legacy") {
+      await capture.capture({ url: "https://example.test", headers: {}, body: upstreamRequestBody, bodyString: JSON.stringify(upstreamRequestBody) });
+    }
+    await saveCallLog({
+      id, model: "model", provider: "codex", status: 200,
+      clientRequestBody: { reasoning_effort: "low" }, upstreamRequestBody,
+      reasoningEffortUpstream,
+      responseBody: { choices: [{ message: { content: "ok" } }] },
+    });
+  }
+  const db = core.getDbInstance();
+  const logs = await getCallLogs({ limit: 20 });
+  const rows = buildCallLogListRows({ logs, connections: [], pendingDetails: [], completedDetails: [] });
+  for (const [id, , expected] of cases) {
+    const stored = db.prepare("SELECT reasoning_effort_upstream, reasoning_source FROM call_logs WHERE id = ?").get(id) as { reasoning_effort_upstream: string | null; reasoning_source: string | null };
+    assert.equal(stored.reasoning_effort_upstream, expected);
+    assert.notEqual(stored.reasoning_source, "encrypted");
+    assert.equal(rows.find((row: { id: string }) => row.id === id)?.reasoningEffortUpstream, expected);
+  }
+  const now = Date.now();
+  const memoryRows = buildCallLogListRows({
+    logs: [], connections: [], now,
+    pendingDetails: [{ id: "pending", model: "model", provider: "codex", startedAt: now, reasoningEffortUpstream: "xhigh" }],
+    completedDetails: [{ id: "complete", model: "model", provider: "codex", startedAt: now, reasoningEffortUpstream: "ultra" }, { id: "old", model: "model", provider: "codex", startedAt: now }],
+  });
+  assert.equal(memoryRows.find((row: { id: string }) => row.id === "pending")?.reasoningEffortUpstream, "xhigh");
+  assert.equal(memoryRows.find((row: { id: string }) => row.id === "complete")?.reasoningEffortUpstream, "ultra");
+  assert.equal(memoryRows.find((row: { id: string }) => row.id === "old")?.reasoningEffortUpstream, null);
+});
