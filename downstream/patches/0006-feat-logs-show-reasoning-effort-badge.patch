diff --git a/src/shared/reasoning/upstreamEffort.ts b/src/shared/reasoning/upstreamEffort.ts
new file mode 100644
index 0000000000..1386b67015
--- /dev/null
+++ b/src/shared/reasoning/upstreamEffort.ts
@@ -0,0 +1,17 @@
+import { CANONICAL_EFFORT_VALUES } from "./effortStandardization";
+
+const UPSTREAM_EFFORTS = new Set<string>([...CANONICAL_EFFORT_VALUES, "minimal", "ultra"]);
+
+/** Read only explicitly serialized upstream effort values; never infer a default. */
+export function readUpstreamReasoningEffort(body: unknown): string | null {
+  if (!body || typeof body !== "object" || Array.isArray(body)) return null;
+  const record = body as Record<string, unknown>;
+  const reasoning = record.reasoning;
+  const nested = reasoning && typeof reasoning === "object" && !Array.isArray(reasoning)
+    ? (reasoning as Record<string, unknown>).effort
+    : undefined;
+  const value = record.reasoning_effort !== undefined ? record.reasoning_effort : nested;
+  if (typeof value !== "string") return null;
+  const normalized = value.trim().toLowerCase();
+  return UPSTREAM_EFFORTS.has(normalized) ? normalized : null;
+}
