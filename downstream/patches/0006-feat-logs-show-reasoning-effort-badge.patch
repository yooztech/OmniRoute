+import React from "react";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { NextIntlClientProvider } from "next-intl";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import RequestLoggerV2 from "../../src/shared/components/RequestLoggerV2";
+import { computeLogsSignature } from "../../src/shared/components/requestLoggerSignature";
+import messages from "../../src/i18n/messages/en.json";
+
+vi.mock("next/navigation", () => ({ useRouter: () => ({ push: vi.fn() }) }));
+vi.mock("../../src/shared/components/RequestLoggerDetail", () => ({ default: () => null }));
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  localStorage.clear();
+});
+
+const baseRow = {
+  id: "row-1",
+  model: "codex-model",
+  provider: "openai",
+  status: 200,
+  duration: 100,
+  timestamp: "2026-01-01T00:00:00.000Z",
+  tokens: { in: 10, out: 20 },
+};
+const description = "Reasoning effort sent upstream, not the actual number of reasoning tokens";
+
+describe("upstream reasoning effort in request logs", () => {
+  it("changes the polling signature when effort changes and stays stable otherwise", () => {
+    const high = { ...baseRow, reasoningEffortUpstream: "high" };
+    expect(computeLogsSignature([high])).toBe(computeLogsSignature([{ ...high }]));
+    expect(computeLogsSignature([high])).not.toBe(computeLogsSignature([{ ...high, reasoningEffortUpstream: "xhigh" }]));
+    expect(computeLogsSignature([high])).not.toBe(computeLogsSignature([baseRow]));
+  });
+
+  it("shows known values alongside Fast, hides unknown values, and refreshes changes", async () => {
+    let rows: Record<string, unknown>[] = [
+      { ...baseRow, requestedServiceTier: "priority", reasoningEffortUpstream: "high" },
+      { ...baseRow, id: "row-2", model: "xhigh-model", reasoningEffortUpstream: "xhigh" },
+      { ...baseRow, id: "row-3", model: "minimal-model", reasoningEffortUpstream: "minimal" },
+      { ...baseRow, id: "row-4", model: "null-model", reasoningEffortUpstream: null },
+      { ...baseRow, id: "row-5", model: "unknown-model", reasoningEffortUpstream: "unknown" },
+      { ...baseRow, id: "row-6", model: "old-model" },
+      { ...baseRow, id: "row-7", model: "invalid-model", reasoningEffortUpstream: 42 },
+    ];
+    vi.stubGlobal("fetch", vi.fn(async (url: string) => {
+      const body = url.startsWith("/api/usage/call-logs?") ? rows :
+        url === "/api/provider-nodes" ? { nodes: [] } : {};
+      return new Response(JSON.stringify(body), { status: 200 });
+    }));
+
+    render(
+      <NextIntlClientProvider locale="en" timeZone="UTC" messages={messages}>
+        <RequestLoggerV2 />
+      </NextIntlClientProvider>
+    );
+
+    const badge = await screen.findByLabelText(`${description}: high`);
+    const cell = badge.closest("td")!;
