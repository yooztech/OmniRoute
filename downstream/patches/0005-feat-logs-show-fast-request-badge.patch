diff --git a/tests/unit/call-logs-requested-service-tier.test.ts b/tests/unit/call-logs-requested-service-tier.test.ts
new file mode 100644
index 00000000..20bbf2f3
--- /dev/null
+++ b/tests/unit/call-logs-requested-service-tier.test.ts
@@ -0,0 +1,61 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import Database from "better-sqlite3";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "call-log-tier-"));
+process.env.DATA_DIR = dataDir;
+// These modules read DATA_DIR on import, so initialize the isolated directory first.
+const core = await import("../../src/lib/db/core.ts");
+const { saveCallLog, getCallLogs } = await import("../../src/lib/usage/callLogs.ts");
+const { buildCallLogListRows } = await import("../../src/app/api/usage/call-logs/route.ts");
+
+test.after(() => {
+  core.resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+});
+
+test("migration preserves legacy rows with unknown requested tier", () => {
+  const db = new Database(":memory:");
+  try {
+    db.exec("CREATE TABLE call_logs (id TEXT PRIMARY KEY); INSERT INTO call_logs (id) VALUES ('legacy')");
+    db.exec(fs.readFileSync(path.join(process.cwd(), "src/lib/db/migrations/213_call_logs_requested_service_tier.sql"), "utf8"));
+    assert.deepEqual(db.prepare("SELECT requested_service_tier FROM call_logs WHERE id = 'legacy'").get(), { requested_service_tier: null });
+    db.prepare("INSERT INTO call_logs (id, requested_service_tier) VALUES (?, ?)").run("new", "priority");
+    assert.deepEqual(db.prepare("SELECT requested_service_tier FROM call_logs WHERE id = 'new'").get(), { requested_service_tier: "priority" });
+  } finally {
+    db.close();
+  }
+});
+
+test("persisted and in-memory list rows retain requested tier independently of served tier", async () => {
+  for (const [id, requestedServiceTier, serviceTier] of [
+    ["priority", "priority", "standard"],
+    ["flex", "flex", "priority"],
+    ["unknown", null, "priority"],
+  ] as const) {
+    await saveCallLog({ id, model: "codex", provider: "codex", status: 200, requestedServiceTier, serviceTier });
+  }
+  const logs = await getCallLogs({ limit: 10 });
+  const byId = new Map(logs.map((row) => [row.id, row.requestedServiceTier]));
+  assert.equal(byId.get("priority"), "priority");
+  assert.equal(byId.get("flex"), "flex");
+  assert.equal(byId.get("unknown"), null);
+  const db = core.getDbInstance();
+  assert.deepEqual(db.prepare("SELECT requested_service_tier FROM call_logs WHERE id = ?").get("priority"), { requested_service_tier: "priority" });
+  const now = Date.now();
+  const rows = buildCallLogListRows({
+    logs,
+    connections: [],
+    pendingDetails: [{ id: "active", startedAt: now, model: "codex", requestedServiceTier: "priority", serviceTier: "standard" }],
+    completedDetails: [{ id: "completed", startedAt: now, model: "codex", requestedServiceTier: "flex", serviceTier: "priority" }, { id: "old", startedAt: now, model: "codex", serviceTier: "priority" }],
+    now,
+  });
+  const tiers = new Map(rows.map((row: { id: string; requestedServiceTier: string | null }) => [row.id, row.requestedServiceTier]));
+  assert.equal(tiers.get("active"), "priority");
+  assert.equal(tiers.get("completed"), "flex");
+  assert.equal(tiers.get("old"), null);
+  assert.equal(tiers.get("priority"), "priority");
+});
